<UserControl x:Class="Fiadex.PersonPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Fiadex"
             MinHeight="40">
    <UserControl.Resources>
        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource MonochromeTextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{DynamicResource AppFocusVisualStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource MonochromeSurfaceAltBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource MonochromeSurfaceAltBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource MonochromeMutedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Border x:Name="RootBorder"
                MinHeight="40"
                Background="{DynamicResource MonochromeSurfaceBrush}"
                CornerRadius="10"
                SnapsToDevicePixels="True">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="BorderBrush" Value="{DynamicResource MonochromeBorderBrush}"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=SearchBox}" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource MonochromePrimaryBrush}"/>
                            <Setter Property="BorderThickness" Value="1.5"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="28"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="SearchBox"
                         Grid.Column="0"
                         MinHeight="38"
                         Margin="0"
                         Padding="12,8"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="{DynamicResource MonochromeTextBrush}"
                         FontSize="{DynamicResource FsBase}"
                         VerticalContentAlignment="Center"
                         TextChanged="SearchBox_TextChanged"
                         GotKeyboardFocus="SearchBox_GotKeyboardFocus"
                         PreviewKeyDown="SearchBox_PreviewKeyDown"
                         AutomationProperties.Name="Buscar persona por nombre o teléfono"
                         AutomationProperties.HelpText="Escriba para filtrar la lista de personas"/>

                <TextBlock x:Name="Placeholder"
                           Grid.Column="0"
                           Margin="11,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource MonochromeMutedBrush}"
                           FontSize="{DynamicResource FsBase}"
                           IsHitTestVisible="False"
                           Text="{Binding PlaceholderText, RelativeSource={RelativeSource AncestorType=local:PersonPicker}}"/>

                <Button Grid.Column="1"
                        Focusable="False"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="0"
                        Click="DropDownButton_Click"
                        AutomationProperties.Name="Mostrar lista de personas">
                    <Path Data="M 0 0 L 5 5 L 10 0 Z"
                          Fill="{DynamicResource MonochromeTextBrush}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"/>
                </Button>
            </Grid>
        </Border>

        <Popup x:Name="ResultsPopup"
               PlacementTarget="{Binding ElementName=RootBorder}"
               Placement="Bottom"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="None"
               Opened="ResultsPopup_Opened">
            <Border x:Name="ResultsBorder"
                    Background="{DynamicResource MonochromeSurfaceBrush}"
                    BorderBrush="{DynamicResource MonochromeBorderStrongBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    MinWidth="240"
                    MaxHeight="340"
                    SnapsToDevicePixels="True">
                <DockPanel>
                    <TextBlock x:Name="ResultSummary"
                               DockPanel.Dock="Top"
                               Padding="10,7"
                               FontSize="{DynamicResource FsXs}"
                               Foreground="{DynamicResource MonochromeMutedBrush}"
                               Text="Escriba para buscar"/>
                    <ListBox x:Name="ResultsList"
                             MaxHeight="300"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="{DynamicResource MonochromeTextBrush}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             PreviewMouseLeftButtonUp="ResultsList_PreviewMouseLeftButtonUp"
                             AutomationProperties.Name="Resultados de personas">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:Person}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}"
                                               Foreground="{DynamicResource MonochromeTextBrush}"
                                               FontSize="{DynamicResource FsBase}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Phone}"
                                               Foreground="{DynamicResource MonochromeMutedBrush}"
                                               FontSize="{DynamicResource FsXs}"
                                               TextTrimming="CharacterEllipsis">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Phone}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
