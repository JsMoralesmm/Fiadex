<UserControl x:Class="Fiadex.PasswordField"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="38" d:DesignWidth="300"
             MinHeight="36">

    <UserControl.Resources>
        <Geometry x:Key="IconEye">M12 5c-5 0-9.3 3.1-11 7 1.7 3.9 6 7 11 7s9.3-3.1 11-7c-1.7-3.9-6-7-11-7zm0 11a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm0-1.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5z</Geometry>
    </UserControl.Resources>

    <Grid>
        <PasswordBox x:Name="MaskedBox"
                     Height="44" Margin="0" Padding="12,8,40,8"
                     PasswordChar="●"
                     PasswordChanged="MaskedBox_PasswordChanged"/>

        <TextBox x:Name="RevealedBox"
                 Height="44" Margin="0" Padding="12,8,40,8"
                 Visibility="Collapsed"
                 TextChanged="RevealedBox_TextChanged"/>

        <Button x:Name="ToggleButton"
                Style="{StaticResource GhostButtonStyle}"
                Width="32" Height="32" MinHeight="0" Padding="0" Margin="0,0,4,0"
                Panel.ZIndex="1"
                HorizontalAlignment="Right" VerticalAlignment="Center"
                Click="ToggleButton_Click"
                ToolTip="Mostrar contraseña"
                AutomationProperties.Name="Mostrar contraseña">
            <Grid Width="18" Height="18">
                <Path Data="{StaticResource IconEye}"
                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Path x:Name="Slash"
                      Data="M3,3 L15,15"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                      Visibility="Collapsed"/>
            </Grid>
        </Button>
    </Grid>
</UserControl>
