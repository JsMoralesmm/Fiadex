<Window x:Class="Fiadex.EditLoanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fiadex — Editar Préstamo"
        Height="540" MinHeight="430" Width="430" MinWidth="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{StaticResource MonochromeBackgroundBrush}">

    <Border Margin="24"
            Background="{StaticResource MonochromeSurfaceBrush}"
            BorderBrush="{StaticResource MonochromeBorderBrush}"
            BorderThickness="1"
            CornerRadius="10"
            Padding="28,24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ScrollViewer Grid.Row="0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="0,0,4,0">
                <StackPanel>
                    <TextBlock Text="EDITAR PRÉSTAMO" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource MonochromeSecondaryBrush}"/>
                    <TextBlock Text="Modifica el importe, fecha u observaciones"
                               FontSize="12" Foreground="{StaticResource MonochromeMutedBrush}" Margin="0,2,0,18"/>

                    <TextBlock Text="Monto" FontSize="11.5" Foreground="{StaticResource MonochromeSecondaryBrush}"/>
                    <TextBox x:Name="AmountBox" Height="36" Padding="10,6" Margin="0,4,0,12"/>

                    <TextBlock Text="Fecha del crédito" FontSize="11.5" Foreground="{StaticResource MonochromeSecondaryBrush}"/>
                    <DatePicker x:Name="DateBox" Height="36" Margin="0,4,0,12"/>

                    <TextBlock Text="Notas u observaciones" FontSize="11.5" Foreground="{StaticResource MonochromeSecondaryBrush}"/>
                    <TextBox x:Name="NotesBox" Height="70" AcceptsReturn="True" VerticalContentAlignment="Top" Padding="10,6" Margin="0,4,0,12"/>

                    <TextBlock x:Name="Message" TextWrapping="Wrap"
                               Foreground="{StaticResource MonochromeTextBrush}"
                               FontSize="11.5" FontStyle="Italic"
                               Margin="0,0,0,4"/>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="Cancelar"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Width="110" Height="38" Margin="0"
                        Click="CancelClick"
                        AutomationProperties.Name="Cancelar edición"/>
                <Button Content="Guardar cambios"
                        Width="150" Height="38" Margin="8,0,0,0"
                        Click="SaveClick"
                        AutomationProperties.Name="Guardar cambios del préstamo"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
