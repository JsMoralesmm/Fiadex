<Window x:Class="Fiadex.EditPersonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource ModalWindowStyle}"
        Title="Editar persona"
        Height="450" MinHeight="420" Width="470" MinWidth="430"
        WindowStartupLocation="CenterOwner">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="0,0,4,0">
            <StackPanel>
                <TextBlock Text="Datos del cliente" FontSize="17" FontWeight="SemiBold"
                           Foreground="{DynamicResource MonochromeTextBrush}"/>
                <TextBlock Text="Actualice el nombre o el teléfono de contacto."
                           Style="{StaticResource ModalHintStyle}" Margin="0,4,0,20"/>

                <TextBlock Text="Nombre completo" Style="{StaticResource ModalLabelStyle}"/>
                <TextBox x:Name="NameBox" Margin="0,0,0,14"/>

                <TextBlock Text="Teléfono" Style="{StaticResource ModalLabelStyle}"/>
                <TextBox x:Name="PhoneBox" Margin="0,0,0,6"/>

                <TextBlock x:Name="Message" Style="{StaticResource ModalMessageStyle}"/>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Height="1" Background="{DynamicResource MonochromeBorderBrush}" Margin="0,0,0,14"/>
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancelar"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Width="110" Height="40" Margin="0"
                        IsCancel="True"
                        Click="CancelClick"
                        AutomationProperties.Name="Cancelar edición"/>
                <Button Content="Guardar cambios"
                        Width="150" Height="40" Margin="8,0,0,0"
                        IsDefault="True"
                        Click="SaveClick"
                        AutomationProperties.Name="Guardar cambios de la persona"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
