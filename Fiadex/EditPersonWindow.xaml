<Window x:Class="Fiadex.EditPersonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fiadex — Editar Persona"
        Height="430" MinHeight="380" Width="430" MinWidth="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{DynamicResource MonochromeBackgroundBrush}">

    <Border Margin="24"
            Background="{DynamicResource MonochromeSurfaceBrush}"
            BorderBrush="{DynamicResource MonochromeBorderBrush}"
            BorderThickness="1"
            CornerRadius="10"
            Padding="28,24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ScrollViewer Grid.Row="0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="0,0,4,0">
                <StackPanel>
                    <TextBlock Text="EDITAR PERSONA" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource MonochromeSecondaryBrush}"/>
                    <TextBlock Text="Modifica el nombre o teléfono del cliente"
                               FontSize="12" Foreground="{DynamicResource MonochromeMutedBrush}" Margin="0,2,0,18"/>

                    <TextBlock Text="Nombre completo" FontSize="11.5" Foreground="{DynamicResource MonochromeSecondaryBrush}"/>
                    <TextBox x:Name="NameBox" Height="36" Padding="10,6" Margin="0,4,0,12"/>

                    <TextBlock Text="Teléfono" FontSize="11.5" Foreground="{DynamicResource MonochromeSecondaryBrush}"/>
                    <TextBox x:Name="PhoneBox" Height="36" Padding="10,6" Margin="0,4,0,12"/>

                    <TextBlock x:Name="Message" TextWrapping="Wrap"
                               Foreground="{DynamicResource MonochromeTextBrush}"
                               FontSize="11.5" FontStyle="Italic"
                               Margin="0,0,0,4"/>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="Cancelar"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Width="110" Height="38" Margin="0"
                        Click="CancelClick"
                        AutomationProperties.Name="Cancelar edición"/>
                <Button Content="Guardar cambios"
                        Width="150" Height="38" Margin="8,0,0,0"
                        Click="SaveClick"
                        AutomationProperties.Name="Guardar cambios de la persona"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>

