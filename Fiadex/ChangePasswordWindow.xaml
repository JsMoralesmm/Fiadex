<Window x:Class="Fiadex.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Fiadex"
        Style="{StaticResource ModalWindowStyle}"
        Title="Cambiar contraseña"
        Height="520" MinHeight="470" Width="470" MinWidth="430"
        WindowStartupLocation="CenterOwner">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="0,0,4,0">
            <StackPanel>
                <TextBlock Text="Seguridad de la cuenta" FontSize="17" FontWeight="SemiBold"
                           Foreground="{DynamicResource MonochromeTextBrush}"/>
                <TextBlock Text="Actualice la clave de acceso al sistema."
                           Style="{StaticResource ModalHintStyle}" Margin="0,4,0,20"/>

                <TextBlock Text="Contraseña actual" Style="{StaticResource ModalLabelStyle}"/>
                <local:PasswordField x:Name="CurrentPasswordField" Height="44" Margin="0,0,0,14"
                                     AutomationProperties.Name="Contraseña actual"/>

                <TextBlock Text="Nueva contraseña" Style="{StaticResource ModalLabelStyle}"/>
                <local:PasswordField x:Name="NewPasswordField" Height="44" Margin="0,0,0,14"
                                     AutomationProperties.Name="Nueva contraseña"/>

                <TextBlock Text="Repita la nueva contraseña" Style="{StaticResource ModalLabelStyle}"/>
                <local:PasswordField x:Name="RepeatPasswordField" Height="44" Margin="0,0,0,6"
                                     AutomationProperties.Name="Repita la nueva contraseña"/>

                <TextBlock x:Name="Message" Style="{StaticResource ModalMessageStyle}"/>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Height="1" Background="{DynamicResource MonochromeBorderBrush}" Margin="0,0,0,14"/>
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancelar"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Width="110" Height="40" Margin="0"
                        IsCancel="True"
                        Click="CancelClick"
                        AutomationProperties.Name="Cancelar"/>
                <Button Content="Guardar nueva contraseña"
                        Width="200" Height="40" Margin="8,0,0,0"
                        IsDefault="True"
                        Click="SaveClick"
                        AutomationProperties.Name="Guardar nueva contraseña"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
