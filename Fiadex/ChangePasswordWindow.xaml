<Window x:Class="Fiadex.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Fiadex"
        Title="Fiadex — Cambiar Contraseña"
        Height="540" MinHeight="430" Width="430" MinWidth="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{StaticResource MonochromeBackgroundBrush}">

    <Border Margin="24"
            Background="{StaticResource MonochromeSurfaceBrush}"
            BorderBrush="{StaticResource MonochromeBorderBrush}"
            BorderThickness="1"
            CornerRadius="10"
            Padding="28,24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ScrollViewer Grid.Row="0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="0,0,4,0">
                <StackPanel>
                    <TextBlock Text="CAMBIAR CONTRASEÑA" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource MonochromeSecondaryBrush}"/>
                    <TextBlock Text="Actualiza tu clave de acceso al sistema"
                               FontSize="12" Foreground="{StaticResource MonochromeMutedBrush}" Margin="0,2,0,18"/>

                    <TextBlock Text="Contraseña actual" FontSize="11.5" Foreground="{StaticResource MonochromeSecondaryBrush}"/>
                    <local:PasswordField x:Name="CurrentPasswordField" Height="38" Margin="0,4,0,12"
                                         AutomationProperties.Name="Contraseña actual"/>

                    <TextBlock Text="Nueva contraseña" FontSize="11.5" Foreground="{StaticResource MonochromeSecondaryBrush}"/>
                    <local:PasswordField x:Name="NewPasswordField" Height="38" Margin="0,4,0,12"
                                         AutomationProperties.Name="Nueva contraseña"/>

                    <TextBlock Text="Repita la nueva contraseña" FontSize="11.5" Foreground="{StaticResource MonochromeSecondaryBrush}"/>
                    <local:PasswordField x:Name="RepeatPasswordField" Height="38" Margin="0,4,0,12"
                                         AutomationProperties.Name="Repita la nueva contraseña"/>

                    <TextBlock x:Name="Message" TextWrapping="Wrap"
                               Foreground="{StaticResource MonochromeTextBrush}"
                               FontSize="11.5" FontStyle="Italic"
                               Margin="0,0,0,4"/>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="Cancelar"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Width="110" Height="38" Margin="0"
                        Click="CancelClick"
                        AutomationProperties.Name="Cancelar"/>
                <Button Content="Guardar nueva contraseña"
                        Width="190" Height="38" Margin="8,0,0,0"
                        Click="SaveClick"
                        AutomationProperties.Name="Guardar nueva contraseña"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
