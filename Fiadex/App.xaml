<Application x:Class="Fiadex.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:presentationOptions="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
             xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
             xmlns:prim="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
             xmlns:local="clr-namespace:Fiadex">
    <Application.Resources>
        <!-- Value Converters -->
        <local:CountToVisibilityConverter x:Key="CountToVisibility"/>
        <local:InverseCountToVisibilityConverter x:Key="InverseCountToVisibility"/>
        <local:BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <local:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility"/>
        <local:InverseBooleanConverter x:Key="InverseBool"/>
        <local:StringToVisibilityConverter x:Key="StringToVisibility"/>
        <local:BalanceStatusConverter x:Key="BalanceStatus"/>
        <local:SidebarWidthConverter x:Key="SidebarWidth"/>
        <local:SidebarGridColumnConverter x:Key="SidebarGridColumn"/>
        <local:SidebarColumnSpanConverter x:Key="SidebarColumnSpan"/>
        <local:SidebarIconMarginConverter x:Key="SidebarIconMargin"/>
        <local:SidebarNavIconColumnConverter x:Key="SidebarNavIconColumn"/>
        <local:SidebarNavPaddingConverter x:Key="SidebarNavPadding"/>
        <local:SidebarActionIconMarginConverter x:Key="SidebarActionIconMargin"/>
        <local:SidebarActionAlignmentConverter x:Key="SidebarActionAlignment"/>
        <local:SidebarActionPaddingConverter x:Key="SidebarActionPadding"/>
        <local:RoleToAlignmentConverter x:Key="RoleToAlignment"/>
        <local:RoleToBubbleBackgroundConverter x:Key="RoleToBubbleBg"/>
        <local:RoleToBubbleForegroundConverter x:Key="RoleToBubbleFg"/>
        <local:RoleToBubbleBorderConverter x:Key="RoleToBubbleBorder"/>
        <local:RoleToSenderNameConverter x:Key="RoleToSenderName"/>
        <local:RoleToCornerRadiusConverter x:Key="RoleToCornerRadius"/>
        <local:RoleToMarginConverter x:Key="RoleToMargin"/>

        <!-- Monochromatic Design System Tokens: capas oscuras y contraste alto. -->
        <Color x:Key="MonochromeBgColor">#0B0B0F</Color>
        <Color x:Key="MonochromeSurfaceColor">#15151B</Color>
        <Color x:Key="MonochromeSurfaceAltColor">#1E1E26</Color>
        <Color x:Key="MonochromeBorderColor">#2B2B35</Color>
        <Color x:Key="MonochromeBorderLightColor">#22222B</Color>
        <Color x:Key="MonochromeBorderStrongColor">#3F3F4C</Color>
        <Color x:Key="MonochromePrimaryColor">#F5F5F7</Color>
        <Color x:Key="MonochromeHoverColor">#FFFFFF</Color>
        <Color x:Key="MonochromeSecondaryColor">#C7C7D1</Color>
        <Color x:Key="MonochromeMutedColor">#8E8E99</Color>
        <Color x:Key="MonochromeTextColor">#F7F7F9</Color>
        <Color x:Key="MonochromeDisabledColor">#5C5C67</Color>
        <Color x:Key="MonochromeOnPrimaryColor">#0B0B0F</Color>

        <!-- Sidebar Tokens -->
        <Color x:Key="MonochromeSidebarColor">#08080B</Color>
        <Color x:Key="MonochromeSidebarBorderColor">#1D1D25</Color>
        <Color x:Key="MonochromeSidebarTextColor">#F7F7F9</Color>
        <Color x:Key="MonochromeSidebarMutedColor">#92929D</Color>
        <Color x:Key="MonochromeSidebarHoverColor">#1A1A22</Color>
        <Color x:Key="MonochromeSidebarSelectedColor">#272730</Color>

        <!-- Solid Color Brushes -->
        <SolidColorBrush presentationOptions:Freeze="False" x:Key="MonochromeBackgroundBrush" Color="{DynamicResource MonochromeBgColor}"/>
        <SolidColorBrush presentationOptions:Freeze="False" x:Key="MonochromeSurfaceBrush" Color="{DynamicResource MonochromeSurfaceColor}"/>
        <SolidColorBrush presentationOptions:Freeze="False" x:Key="MonochromeSurfaceAltBrush" Color="{DynamicResource MonochromeSurfaceAltColor}"/>
        <SolidColorBrush presentationOptions:Freeze="False" x:Key="MonochromeBorderBrush" Color="{DynamicResource MonochromeBorderColor}"/>
        <SolidColorBrush presentationOptions:Freeze="False" x:Key="MonochromeBorderLightBrush" Color="{DynamicResource MonochromeBorderLightColor}"/>
        <SolidColorBrush presentationOptions:Freeze="False" x:Key="MonochromeBorderStrongBrush" Color="{DynamicResource MonochromeBorderStrongColor}"/>
        <SolidColorBrush presentationOptions:Freeze="False" x:Key="MonochromePrimaryBrush" Color="{DynamicResource MonochromePrimaryColor}"/>
        <SolidColorBrush presentationOptions:Freeze="False" x:Key="MonochromeHoverBrush" Color="{DynamicResource MonochromeHoverColor}"/>
        <SolidColorBrush presentationOptions:Freeze="False" x:Key="MonochromeSecondaryBrush" Color="{DynamicResource MonochromeSecondaryColor}"/>
        <SolidColorBrush presentationOptions:Freeze="False" x:Key="MonochromeMutedBrush" Color="{DynamicResource MonochromeMutedColor}"/>
        <SolidColorBrush presentationOptions:Freeze="False" x:Key="MonochromeTextBrush" Color="{DynamicResource MonochromeTextColor}"/>
        <SolidColorBrush presentationOptions:Freeze="False" x:Key="MonochromeDisabledBrush" Color="{DynamicResource MonochromeDisabledColor}"/>
        <SolidColorBrush presentationOptions:Freeze="False" x:Key="MonochromeOnPrimaryBrush" Color="{DynamicResource MonochromeOnPrimaryColor}"/>

        <!-- Sidebar Brushes -->
        <SolidColorBrush presentationOptions:Freeze="False" x:Key="MonochromeSidebarBrush" Color="{DynamicResource MonochromeSidebarColor}"/>
        <SolidColorBrush presentationOptions:Freeze="False" x:Key="MonochromeSidebarBorderBrush" Color="{DynamicResource MonochromeSidebarBorderColor}"/>
        <SolidColorBrush presentationOptions:Freeze="False" x:Key="MonochromeSidebarTextBrush" Color="{DynamicResource MonochromeSidebarTextColor}"/>
        <SolidColorBrush presentationOptions:Freeze="False" x:Key="MonochromeSidebarMutedBrush" Color="{DynamicResource MonochromeSidebarMutedColor}"/>
        <SolidColorBrush presentationOptions:Freeze="False" x:Key="MonochromeSidebarHoverBrush" Color="{DynamicResource MonochromeSidebarHoverColor}"/>
        <SolidColorBrush presentationOptions:Freeze="False" x:Key="MonochromeSidebarSelectedBrush" Color="{DynamicResource MonochromeSidebarSelectedColor}"/>

        <!-- Elevación sutil: da profundidad sin salir de la escala de grises. -->
        <DropShadowEffect presentationOptions:Freeze="True" x:Key="CardShadow"
                          Color="#000000" Opacity="0.28" ShadowDepth="2" BlurRadius="14"/>
        <DropShadowEffect presentationOptions:Freeze="True" x:Key="FloatingShadow"
                          Color="#000000" Opacity="0.38" ShadowDepth="6" BlurRadius="22"/>

        <!-- Tamaños de texto (los ajusta AccessibilityService) -->
        <sys:Double x:Key="FsXs">11</sys:Double>
        <sys:Double x:Key="FsSm">12</sys:Double>
        <sys:Double x:Key="FsMd">13</sys:Double>
        <sys:Double x:Key="FsBase">13.5</sys:Double>

        <!-- Tipografía global seleccionable desde Accesibilidad -->
        <FontFamily x:Key="AppFontFamily">Segoe UI Variable Text, Segoe UI, -apple-system, sans-serif</FontFamily>

        <!-- Indicador de foco: fino por defecto, reforzado si se activa "Foco visible" -->
        <Visibility x:Key="SpinnerAnimationVisibility">Visible</Visibility>
        <Visibility x:Key="SpinnerStaticVisibility">Collapsed</Visibility>

        <Style x:Key="DefaultFocusVisualStyle" TargetType="Control">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Rectangle SnapsToDevicePixels="True"
                                   Stroke="{DynamicResource MonochromeSecondaryBrush}"
                                   StrokeThickness="1"
                                   StrokeDashArray="1 2"
                                   Margin="-2"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StrongFocusVisualStyle" TargetType="Control">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Rectangle SnapsToDevicePixels="True"
                                   Stroke="{DynamicResource MonochromeTextBrush}"
                                   StrokeThickness="2.5"
                                   Margin="-3"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="VeryStrongFocusVisualStyle" TargetType="Control">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Rectangle SnapsToDevicePixels="True"
                                   Stroke="{DynamicResource MonochromeTextBrush}"
                                   StrokeThickness="3"
                                   Margin="-4"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AppFocusVisualStyle" TargetType="Control" BasedOn="{StaticResource DefaultFocusVisualStyle}"/>

        <!-- Global Window Style -->
        <Style TargetType="Window">
            <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
            <Setter Property="FontSize" Value="{DynamicResource FsBase}"/>
            <Setter Property="Background" Value="{DynamicResource MonochromeBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource MonochromeTextBrush}"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <!-- Global TextBlock Style.
             No se fija Foreground aquí: los TextBlock generados dentro de los botones
             deben heredar Button.Foreground. Si se fija aquí, el texto de los botones
             oscuros queda oscuro y deja de verse. -->
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
        </Style>

        <!-- Global TextBox Style -->
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,5,0,14"/>
            <Setter Property="Background" Value="{DynamicResource MonochromeSurfaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource MonochromeTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource MonochromeBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="{DynamicResource FsBase}"/>
            <Setter Property="FocusVisualStyle" Value="{DynamicResource AppFocusVisualStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="BoxBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"
                                          Padding="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BoxBorder" Property="BorderBrush" Value="{DynamicResource MonochromeBorderStrongBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="BoxBorder" Property="BorderBrush" Value="{DynamicResource MonochromePrimaryBrush}"/>
                                <Setter TargetName="BoxBorder" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BoxBorder" Property="Background" Value="{DynamicResource MonochromeSurfaceAltBrush}"/>
                                <Setter TargetName="BoxBorder" Property="BorderBrush" Value="{DynamicResource MonochromeBorderBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource MonochromeMutedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Validation.ErrorTemplate">
                <Setter.Value>
                    <ControlTemplate>
                        <StackPanel>
                            <AdornedElementPlaceholder x:Name="ErrorPlaceholder"/>
                            <TextBlock Text="{Binding [0].ErrorContent}"
                                       Foreground="{DynamicResource MonochromeSecondaryBrush}"
                                       FontSize="11" Margin="2,2,0,0"
                                       FontStyle="Italic"/>
                        </StackPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Global PasswordBox Style -->
        <Style TargetType="PasswordBox">
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,5,0,14"/>
            <Setter Property="Background" Value="{DynamicResource MonochromeSurfaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource MonochromeTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource MonochromeBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="{DynamicResource FsBase}"/>
            <Setter Property="FocusVisualStyle" Value="{DynamicResource AppFocusVisualStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="PasswordBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"
                                          Padding="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PasswordBorder" Property="BorderBrush" Value="{DynamicResource MonochromeBorderStrongBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="PasswordBorder" Property="BorderBrush" Value="{DynamicResource MonochromePrimaryBrush}"/>
                                <Setter TargetName="PasswordBorder" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="PasswordBorder" Property="Background" Value="{DynamicResource MonochromeSurfaceAltBrush}"/>
                                <Setter TargetName="PasswordBorder" Property="BorderBrush" Value="{DynamicResource MonochromeBorderBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource MonochromeMutedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Global ComboBox Style.
             La plantilla de WPF dibuja el desplegable con SystemColors (blanco),
             que no sigue la paleta: en el tema Negro el texto queda blanco sobre
             blanco. Por eso se usa una plantilla propia que toma los colores
             de la paleta de la aplicación. -->
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,5,0,14"/>
            <Setter Property="Background" Value="{DynamicResource MonochromeSurfaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource MonochromeTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource MonochromeBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="{DynamicResource FsBase}"/>
            <Setter Property="FocusVisualStyle" Value="{DynamicResource AppFocusVisualStyle}"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid SnapsToDevicePixels="True">
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Placement="Bottom"
                                   PopupAnimation="None"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Margin="0,2">
                                <Border x:Name="DropDownBorder"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        SnapsToDevicePixels="True">
                                    <ScrollViewer x:Name="DropDownScrollViewer"
                                                  Padding="4"
                                                  CanContentScroll="True"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <ItemsPresenter x:Name="ItemsPresenter"
                                                        KeyboardNavigation.DirectionalNavigation="Contained"
                                                        SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                            <Border x:Name="ComboBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10"
                                    SnapsToDevicePixels="True">
                                <Grid Margin="{TemplateBinding Padding}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="22"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter x:Name="ContentSite"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                      HorizontalAlignment="Left"
                                                      IsHitTestVisible="False"
                                                      TextElement.Foreground="{TemplateBinding Foreground}"/>
                                    <Path x:Name="Arrow"
                                          Grid.Column="1"
                                          Data="M 0 0 L 5 5 L 10 0 Z"
                                          Fill="{TemplateBinding Foreground}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <ToggleButton x:Name="DropDownButton"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          Focusable="False"
                                          ClickMode="Press"
                                          Cursor="Hand">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{DynamicResource MonochromeBorderStrongBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{DynamicResource MonochromePrimaryBrush}"/>
                                <Setter TargetName="ComboBorder" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{DynamicResource MonochromePrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ComboBorder" Property="Background" Value="{DynamicResource MonochromeSurfaceAltBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource MonochromeMutedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Global ComboBoxItem Style: el texto y el fondo siguen siempre la paleta. -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource MonochromeTextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{DynamicResource AppFocusVisualStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource MonochromeSurfaceAltBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource MonochromeTextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource MonochromeSurfaceAltBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource MonochromeTextBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource MonochromeMutedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Button Style (Default Button) -->
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="Background" Value="{DynamicResource MonochromePrimaryBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource MonochromeOnPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource MonochromePrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="{DynamicResource FsBase}"/>
            <Setter Property="FocusVisualStyle" Value="{DynamicResource AppFocusVisualStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource MonochromeHoverBrush}"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource MonochromeHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource MonochromeHoverBrush}"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource MonochromeHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource MonochromeSurfaceAltBrush}"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource MonochromeBorderBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource MonochromeMutedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Button Style -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="Background" Value="{DynamicResource MonochromeSurfaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource MonochromeTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource MonochromeBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="{DynamicResource FsBase}"/>
            <Setter Property="FocusVisualStyle" Value="{DynamicResource AppFocusVisualStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="SecBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SecBorder" Property="Background" Value="{DynamicResource MonochromeSurfaceAltBrush}"/>
                                <Setter TargetName="SecBorder" Property="BorderBrush" Value="{DynamicResource MonochromeBorderStrongBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="SecBorder" Property="Background" Value="{DynamicResource MonochromeBorderBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="SecBorder" Property="Background" Value="{DynamicResource MonochromeSurfaceAltBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource MonochromeMutedBrush}"/>
                                <Setter TargetName="SecBorder" Property="BorderBrush" Value="{DynamicResource MonochromeBorderBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Danger Outline Button Style (Monochromatic) -->
        <Style x:Key="DangerOutlineButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Foreground" Value="{DynamicResource MonochromeSecondaryBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource MonochromeTextBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource MonochromePrimaryBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Ghost Button Style -->
        <Style x:Key="GhostButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource MonochromeSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="{DynamicResource FsSm}"/>
            <Setter Property="FocusVisualStyle" Value="{DynamicResource AppFocusVisualStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="GhostBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="GhostBorder" Property="Background" Value="{DynamicResource MonochromeSurfaceAltBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource MonochromeTextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="GhostBorder" Property="Background" Value="{DynamicResource MonochromeBorderBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource MonochromeMutedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Fechas: DatePicker y calendario desplegable con la misma paleta. -->
        <Style TargetType="DatePickerTextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource MonochromeTextBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource MonochromeTextBrush}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource MonochromeBorderStrongBrush}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="{DynamicResource FsBase}"/>
        </Style>

        <Style x:Key="DarkCalendarDayButtonStyle" TargetType="prim:CalendarDayButton">
            <Setter Property="MinWidth" Value="34"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="FontSize" Value="{DynamicResource FsSm}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource MonochromeTextBrush}"/>
            <Setter Property="FocusVisualStyle" Value="{DynamicResource AppFocusVisualStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="prim:CalendarDayButton">
                        <Grid Margin="1">
                            <Rectangle x:Name="HoverBackground" RadiusX="8" RadiusY="8"
                                       Fill="{DynamicResource MonochromeSurfaceAltBrush}"
                                       Visibility="Collapsed"/>
                            <Rectangle x:Name="TodayBorder" RadiusX="8" RadiusY="8"
                                       Stroke="{DynamicResource MonochromeBorderStrongBrush}"
                                       StrokeThickness="1" Fill="Transparent" Visibility="Collapsed"/>
                            <Rectangle x:Name="SelectedBackground" RadiusX="8" RadiusY="8"
                                       Fill="{DynamicResource MonochromePrimaryBrush}"
                                       Visibility="Collapsed"/>
                            <ContentPresenter x:Name="NormalText"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsToday" Value="True">
                                <Setter TargetName="TodayBorder" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HoverBackground" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="SelectedBackground" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="TodayBorder" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="HoverBackground" Property="Visibility" Value="Collapsed"/>
                                <Setter Property="Foreground" Value="{DynamicResource MonochromeOnPrimaryBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsInactive" Value="True">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkCalendarButtonStyle" TargetType="prim:CalendarButton">
            <Setter Property="MinWidth" Value="72"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="FontSize" Value="{DynamicResource FsBase}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource MonochromeTextBrush}"/>
            <Setter Property="FocusVisualStyle" Value="{DynamicResource AppFocusVisualStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="prim:CalendarButton">
                        <Border x:Name="ButtonBorder" Margin="2"
                                Background="Transparent" BorderThickness="0" CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource MonochromeSurfaceAltBrush}"/>
                            </Trigger>
                            <Trigger Property="HasSelectedDays" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource MonochromePrimaryBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource MonochromeOnPrimaryBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsInactive" Value="True">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="prim:CalendarItem">
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="prim:CalendarItem">
                        <ControlTemplate.Resources>
                            <DataTemplate x:Key="{x:Static prim:CalendarItem.DayTitleTemplateResourceKey}">
                                <TextBlock Text="{Binding}"
                                           Foreground="{DynamicResource MonochromeMutedBrush}"
                                           FontSize="{DynamicResource FsXs}"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Margin="0,2,0,4"/>
                            </DataTemplate>

                            <ControlTemplate x:Key="HeaderButtonTemplate" TargetType="Button">
                                <Border x:Name="HeaderBorder" Background="Transparent" CornerRadius="8" Padding="10,4">
                                    <ContentPresenter Content="{TemplateBinding Content}"
                                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                                      TextElement.Foreground="{DynamicResource MonochromeTextBrush}"
                                                      TextElement.FontSize="{DynamicResource FsMd}"
                                                      TextElement.FontWeight="SemiBold"
                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="HeaderBorder" Property="Background" Value="{DynamicResource MonochromeSurfaceAltBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>

                            <ControlTemplate x:Key="PreviousButtonTemplate" TargetType="Button">
                                <Border x:Name="NavBorder" Width="32" Height="32" Background="Transparent" CornerRadius="8">
                                    <Path Data="M15 7l-6 7 6 7" Stroke="{DynamicResource MonochromeSecondaryBrush}"
                                          StrokeThickness="1.8" Fill="Transparent" Stretch="Uniform" Margin="10"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="NavBorder" Property="Background" Value="{DynamicResource MonochromeSurfaceAltBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.3"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>

                            <ControlTemplate x:Key="NextButtonTemplate" TargetType="Button">
                                <Border x:Name="NavBorder" Width="32" Height="32" Background="Transparent" CornerRadius="8">
                                    <Path Data="M9 7l6 7-6 7" Stroke="{DynamicResource MonochromeSecondaryBrush}"
                                          StrokeThickness="1.8" Fill="Transparent" Stretch="Uniform" Margin="10"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="NavBorder" Property="Background" Value="{DynamicResource MonochromeSurfaceAltBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.3"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ControlTemplate.Resources>

                        <Grid x:Name="PART_Root" HorizontalAlignment="Center" Margin="2">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <Grid x:Name="Header" Grid.Row="0" Height="42">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <!-- Flechas de navegación ocultas: el calendario se bugueaba al
                                             usarlas. La navegación se hace con los selectores Mes/Año. -->
                                        <Button x:Name="PART_PreviousButton" Grid.Column="0"
                                                Visibility="Collapsed"
                                                Focusable="False" HorizontalAlignment="Left"
                                                Width="34" Height="34" Margin="2,0,0,0"
                                                Template="{StaticResource PreviousButtonTemplate}"/>
                                        <Button x:Name="PART_HeaderButton" Grid.Column="1"
                                                Focusable="False" HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Template="{StaticResource HeaderButtonTemplate}"/>
                                        <Button x:Name="PART_NextButton" Grid.Column="2"
                                                Visibility="Collapsed"
                                                Focusable="False" HorizontalAlignment="Right"
                                                Width="34" Height="34" Margin="0,0,2,0"
                                                Template="{StaticResource NextButtonTemplate}"/>
                                    </Grid>

                                    <Grid x:Name="PART_MonthView" Grid.Row="1"
                                          Visibility="Visible" HorizontalAlignment="Center"
                                          Margin="8,0,8,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="34"/><ColumnDefinition Width="34"/>
                                            <ColumnDefinition Width="34"/><ColumnDefinition Width="34"/>
                                            <ColumnDefinition Width="34"/><ColumnDefinition Width="34"/>
                                            <ColumnDefinition Width="34"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="30"/><RowDefinition Height="34"/>
                                            <RowDefinition Height="34"/><RowDefinition Height="34"/>
                                            <RowDefinition Height="34"/><RowDefinition Height="34"/>
                                            <RowDefinition Height="34"/>
                                        </Grid.RowDefinitions>
                                    </Grid>

                                    <Grid x:Name="PART_YearView" Grid.Row="1"
                                          Visibility="Hidden" HorizontalAlignment="Center"
                                          Margin="8,6,8,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="68"/><ColumnDefinition Width="68"/>
                                            <ColumnDefinition Width="68"/><ColumnDefinition Width="68"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="42"/><RowDefinition Height="42"/>
                                            <RowDefinition Height="42"/>
                                        </Grid.RowDefinitions>
                                    </Grid>
                                </Grid>
                            </Border>

                            <Rectangle x:Name="PART_DisabledVisual" Fill="#900B0B0F"
                                       RadiusX="10" RadiusY="10" Visibility="Collapsed"
                                       IsHitTestVisible="False"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="PART_DisabledVisual" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding Visibility, ElementName=PART_YearView}" Value="Visible">
                                <Setter TargetName="PART_MonthView" Property="Visibility" Value="Hidden"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Visibility, ElementName=PART_MonthView}" Value="Visible">
                                <Setter TargetName="PART_YearView" Property="Visibility" Value="Hidden"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkCalendarStyle" TargetType="Calendar">
            <Setter Property="Background" Value="{DynamicResource MonochromeSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource MonochromeBorderStrongBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource MonochromeTextBrush}"/>
            <Setter Property="FontSize" Value="{DynamicResource FsBase}"/>
            <Setter Property="Effect" Value="{StaticResource FloatingShadow}"/>
            <Setter Property="CalendarDayButtonStyle" Value="{StaticResource DarkCalendarDayButtonStyle}"/>
            <Setter Property="CalendarButtonStyle" Value="{StaticResource DarkCalendarButtonStyle}"/>
            <Setter Property="FocusVisualStyle" Value="{DynamicResource AppFocusVisualStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Calendar">
                        <prim:CalendarItem x:Name="PART_CalendarItem"
                                           Background="{TemplateBinding Background}"
                                           BorderBrush="{TemplateBinding BorderBrush}"
                                           BorderThickness="{TemplateBinding BorderThickness}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DatePicker">
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Margin" Value="0,4,0,12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="{DynamicResource FsBase}"/>
            <Setter Property="Foreground" Value="{DynamicResource MonochromeTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource MonochromeSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource MonochromeBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CalendarStyle" Value="{StaticResource DarkCalendarStyle}"/>
            <Setter Property="FocusVisualStyle" Value="{DynamicResource AppFocusVisualStyle}"/>
            <Setter Property="local:CalendarPopupEnhancer.Enhance" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DatePicker">
                        <Border x:Name="RootBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <DatePickerTextBox x:Name="PART_TextBox"
                                                   Grid.Column="0"
                                                   Padding="12,0,4,0"
                                                   Background="Transparent"
                                                   BorderThickness="0"
                                                   Foreground="{TemplateBinding Foreground}"
                                                   FontSize="{TemplateBinding FontSize}"
                                                   VerticalContentAlignment="Center"/>

                                <Button x:Name="PART_Button"
                                        Grid.Column="1"
                                        Width="40"
                                        Height="40"
                                        Margin="0"
                                        Padding="0"
                                        MinHeight="0"
                                        Focusable="False"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        Cursor="Hand"
                                        Foreground="{DynamicResource MonochromeSecondaryBrush}"
                                        ToolTip="Seleccionar fecha"
                                        AutomationProperties.Name="Abrir calendario">
                                    <Path Data="M4 6h16a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1z M3 10h18 M8 3v4 M16 3v4"
                                          Width="18" Height="18" Stretch="Uniform"
                                          SnapsToDevicePixels="True"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.5"
                                          StrokeLineJoin="Round"
                                          Fill="Transparent"/>
                                </Button>

                                <Popup x:Name="PART_Popup"
                                       Grid.ColumnSpan="2"
                                       AllowsTransparency="True"
                                       Focusable="False"
                                       Placement="Bottom"
                                       PlacementTarget="{Binding ElementName=RootBorder}"
                                       HorizontalOffset="0"
                                       VerticalOffset="4"
                                       StaysOpen="False"
                                       PopupAnimation="None"
                                       IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RootBorder" Property="BorderBrush" Value="{DynamicResource MonochromeBorderStrongBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="RootBorder" Property="BorderBrush" Value="{DynamicResource MonochromeTextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="RootBorder" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sidebar Navigation ListBox and Item Styles -->
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource MonochromeSidebarMutedBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="{DynamicResource FsBase}"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="FocusVisualStyle" Value="{DynamicResource AppFocusVisualStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource MonochromeSidebarHoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource MonochromeSidebarTextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource MonochromeSidebarSelectedBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource MonochromeSidebarTextBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DataGrid Styles (Linear / Notion table styling) -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{DynamicResource MonochromeSurfaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource MonochromeTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource MonochromeBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowHeight" Value="44"/>
            <Setter Property="ColumnHeaderHeight" Value="42"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource MonochromeBorderLightBrush}"/>
            <Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <!-- La edición de registros se hace únicamente desde los botones "Editar ...". -->
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="EnableRowVirtualization" Value="True"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource MonochromeSurfaceAltBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource MonochromeSecondaryBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="{DynamicResource FsXs}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource MonochromeBorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Foreground" Value="{DynamicResource MonochromeTextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{DynamicResource MonochromeTextBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="{DynamicResource MonochromeSurfaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource MonochromeTextBrush}"/>
            <Setter Property="FontSize" Value="{DynamicResource FsMd}"/>
            <Setter Property="FocusVisualStyle" Value="{DynamicResource AppFocusVisualStyle}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource MonochromeSurfaceAltBrush}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource MonochromeSurfaceAltBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource MonochromeTextBrush}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Modern Loading Spinner Template -->
        <ControlTemplate x:Key="SpinnerTemplate">
            <Grid>
                <Ellipse Width="20" Height="20"
                         Stroke="{DynamicResource MonochromePrimaryBrush}"
                         StrokeThickness="2.5"
                         StrokeDashArray="0.7 2.0"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Visibility="{DynamicResource SpinnerAnimationVisibility}">
                    <Ellipse.RenderTransform>
                        <RotateTransform x:Name="SpinnerRotation" CenterX="10" CenterY="10"/>
                    </Ellipse.RenderTransform>
                    <Ellipse.Triggers>
                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetName="SpinnerRotation"
                                                     Storyboard.TargetProperty="Angle"
                                                     From="0" To="360" Duration="0:0:0.85"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Ellipse.Triggers>
                </Ellipse>
                <!-- Sin animación cuando está activo "Reducir movimiento". -->
                <Ellipse Width="20" Height="20"
                         Stroke="{DynamicResource MonochromePrimaryBrush}"
                         StrokeThickness="2.5"
                         StrokeDashArray="0.7 2.0"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Visibility="{DynamicResource SpinnerStaticVisibility}"/>
            </Grid>
        </ControlTemplate>

        <!-- Scrollbars finos, en vez de los clásicos bloques grises de Windows. -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="{DynamicResource MonochromeBorderStrongBrush}"
                                                        CornerRadius="4" Margin="2,0"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="{DynamicResource MonochromeSurfaceAltBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource MonochromeTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource MonochromeBorderStrongBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="{DynamicResource FsSm}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Metric Card Style (Used in Dashboard) -->
        <Style x:Key="MetricCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource MonochromeSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource MonochromeBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="20,18"/>
            <Setter Property="Margin" Value="0,0,14,14"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
        </Style>

        <!-- Panel Card Style -->
        <Style x:Key="PanelCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource MonochromeSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource MonochromeBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="22"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
        </Style>

        <!-- Modales: mismas capas visuales que el login, con chrome propio. -->
        <Geometry x:Key="IconModalLogo">M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5</Geometry>

        <Style x:Key="ModalLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource FsSm}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource MonochromeSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="ModalHintStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource FsSm}"/>
            <Setter Property="Foreground" Value="{DynamicResource MonochromeMutedBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,18"/>
        </Style>

        <Style x:Key="ModalMessageStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource FsSm}"/>
            <Setter Property="Foreground" Value="{DynamicResource MonochromeTextBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="FontStyle" Value="Italic"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>

        <Style x:Key="ModalWindowStyle" TargetType="Window">
            <Setter Property="WindowStyle" Value="None"/>
            <Setter Property="AllowsTransparency" Value="True"/>
            <Setter Property="ResizeMode" Value="CanResize"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource MonochromeTextBrush}"/>
            <Setter Property="FontSize" Value="{DynamicResource FsBase}"/>
            <Setter Property="shell:WindowChrome.WindowChrome">
                <Setter.Value>
                    <shell:WindowChrome CaptionHeight="0"
                                        CornerRadius="18"
                                        ResizeBorderThickness="6"
                                        GlassFrameThickness="0"
                                        UseAeroCaptionButtons="False"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Window">
                        <Border Margin="10"
                                Background="{DynamicResource MonochromeSurfaceBrush}"
                                BorderBrush="{DynamicResource MonochromeBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="18"
                                SnapsToDevicePixels="True"
                                Effect="{StaticResource FloatingShadow}">
                            <Grid ClipToBounds="True">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="58"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0"
                                        Background="{DynamicResource MonochromeSurfaceAltBrush}"
                                        BorderBrush="{DynamicResource MonochromeBorderBrush}"
                                        BorderThickness="0,0,0,1"
                                        CornerRadius="18,18,0,0"
                                        MouseLeftButtonDown="ModalDragClick">
                                    <Grid Margin="20,0,12,0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                                            <Border Width="30" Height="30" CornerRadius="9"
                                                    Background="{DynamicResource MonochromePrimaryBrush}"
                                                    Margin="0,0,11,0">
                                                <Path Data="{StaticResource IconModalLogo}"
                                                      Fill="{DynamicResource MonochromeOnPrimaryBrush}"
                                                      Stretch="Uniform" Width="14" Height="14"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{TemplateBinding Title}"
                                                           Foreground="{DynamicResource MonochromeTextBrush}"
                                                           FontSize="15" FontWeight="SemiBold"/>
                                                <TextBlock Text="Fiadex"
                                                           Foreground="{DynamicResource MonochromeMutedBrush}"
                                                           FontSize="{DynamicResource FsXs}" Margin="0,1,0,0"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <Button HorizontalAlignment="Right"
                                                Style="{StaticResource GhostButtonStyle}"
                                                Width="32" Height="32" MinHeight="0" Padding="0"
                                                Content="✕" FontSize="15"
                                                Foreground="{DynamicResource MonochromeSecondaryBrush}"
                                                ToolTip="Cerrar"
                                                AutomationProperties.Name="Cerrar ventana"
                                                Click="CloseModalClick"
                                                shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                                    </Grid>
                                </Border>

                                <ContentPresenter Grid.Row="1"
                                                  Margin="28,22,28,26"
                                                  Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  TextElement.Foreground="{DynamicResource MonochromeTextBrush}"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>

