<Application x:Class="Fiadex.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Fiadex">
    <Application.Resources>
        <!-- Value Converters -->
        <local:CountToVisibilityConverter x:Key="CountToVisibility"/>
        <local:InverseCountToVisibilityConverter x:Key="InverseCountToVisibility"/>
        <local:BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <local:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility"/>
        <local:InverseBooleanConverter x:Key="InverseBool"/>
        <local:StringToVisibilityConverter x:Key="StringToVisibility"/>
        <local:BalanceStatusConverter x:Key="BalanceStatus"/>
        <local:SidebarWidthConverter x:Key="SidebarWidth"/>
        <local:SidebarGridColumnConverter x:Key="SidebarGridColumn"/>
        <local:SidebarColumnSpanConverter x:Key="SidebarColumnSpan"/>
        <local:SidebarIconMarginConverter x:Key="SidebarIconMargin"/>
        <local:SidebarNavIconColumnConverter x:Key="SidebarNavIconColumn"/>
        <local:SidebarNavPaddingConverter x:Key="SidebarNavPadding"/>
        <local:SidebarActionIconMarginConverter x:Key="SidebarActionIconMargin"/>
        <local:SidebarActionAlignmentConverter x:Key="SidebarActionAlignment"/>
        <local:SidebarActionPaddingConverter x:Key="SidebarActionPadding"/>
        <local:RoleToAlignmentConverter x:Key="RoleToAlignment"/>
        <local:RoleToBubbleBackgroundConverter x:Key="RoleToBubbleBg"/>
        <local:RoleToBubbleForegroundConverter x:Key="RoleToBubbleFg"/>
        <local:RoleToBubbleBorderConverter x:Key="RoleToBubbleBorder"/>
        <local:RoleToSenderNameConverter x:Key="RoleToSenderName"/>
        <local:RoleToCornerRadiusConverter x:Key="RoleToCornerRadius"/>
        <local:RoleToMarginConverter x:Key="RoleToMargin"/>

        <!-- Monochromatic Design System Tokens (Linear / Notion inspired) -->
        <Color x:Key="MonochromeBgColor">#F8F9FA</Color>
        <Color x:Key="MonochromeSurfaceColor">#FFFFFF</Color>
        <Color x:Key="MonochromeSurfaceAltColor">#F3F4F6</Color>
        <Color x:Key="MonochromeBorderColor">#E4E4E7</Color>
        <Color x:Key="MonochromeBorderLightColor">#F0F0F2</Color>
        <Color x:Key="MonochromeBorderStrongColor">#D1D5DB</Color>
        <Color x:Key="MonochromePrimaryColor">#18181B</Color>
        <Color x:Key="MonochromeHoverColor">#27272A</Color>
        <Color x:Key="MonochromeSecondaryColor">#62626A</Color>
        <Color x:Key="MonochromeMutedColor">#6C6C74</Color>
        <Color x:Key="MonochromeTextColor">#18181B</Color>
        <Color x:Key="MonochromeDisabledColor">#D4D4D8</Color>

        <!-- Sidebar Tokens -->
        <Color x:Key="MonochromeSidebarColor">#111113</Color>
        <Color x:Key="MonochromeSidebarBorderColor">#222226</Color>
        <Color x:Key="MonochromeSidebarTextColor">#F4F4F5</Color>
        <Color x:Key="MonochromeSidebarMutedColor">#8E8E98</Color>
        <Color x:Key="MonochromeSidebarHoverColor">#1F1F24</Color>
        <Color x:Key="MonochromeSidebarSelectedColor">#27272E</Color>

        <!-- Solid Color Brushes -->
        <SolidColorBrush x:Key="MonochromeBackgroundBrush" Color="{StaticResource MonochromeBgColor}"/>
        <SolidColorBrush x:Key="MonochromeSurfaceBrush" Color="{StaticResource MonochromeSurfaceColor}"/>
        <SolidColorBrush x:Key="MonochromeSurfaceAltBrush" Color="{StaticResource MonochromeSurfaceAltColor}"/>
        <SolidColorBrush x:Key="MonochromeBorderBrush" Color="{StaticResource MonochromeBorderColor}"/>
        <SolidColorBrush x:Key="MonochromeBorderLightBrush" Color="{StaticResource MonochromeBorderLightColor}"/>
        <SolidColorBrush x:Key="MonochromeBorderStrongBrush" Color="{StaticResource MonochromeBorderStrongColor}"/>
        <SolidColorBrush x:Key="MonochromePrimaryBrush" Color="{StaticResource MonochromePrimaryColor}"/>
        <SolidColorBrush x:Key="MonochromeHoverBrush" Color="{StaticResource MonochromeHoverColor}"/>
        <SolidColorBrush x:Key="MonochromeSecondaryBrush" Color="{StaticResource MonochromeSecondaryColor}"/>
        <SolidColorBrush x:Key="MonochromeMutedBrush" Color="{StaticResource MonochromeMutedColor}"/>
        <SolidColorBrush x:Key="MonochromeTextBrush" Color="{StaticResource MonochromeTextColor}"/>
        <SolidColorBrush x:Key="MonochromeDisabledBrush" Color="{StaticResource MonochromeMutedColor}"/>

        <!-- Sidebar Brushes -->
        <SolidColorBrush x:Key="MonochromeSidebarBrush" Color="{StaticResource MonochromeSidebarColor}"/>
        <SolidColorBrush x:Key="MonochromeSidebarBorderBrush" Color="{StaticResource MonochromeSidebarBorderColor}"/>
        <SolidColorBrush x:Key="MonochromeSidebarTextBrush" Color="{StaticResource MonochromeSidebarTextColor}"/>
        <SolidColorBrush x:Key="MonochromeSidebarMutedBrush" Color="{StaticResource MonochromeSidebarMutedColor}"/>
        <SolidColorBrush x:Key="MonochromeSidebarHoverBrush" Color="{StaticResource MonochromeSidebarHoverColor}"/>
        <SolidColorBrush x:Key="MonochromeSidebarSelectedBrush" Color="{StaticResource MonochromeSidebarSelectedColor}"/>

        <!-- Global Window Style -->
        <Style TargetType="Window">
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI, -apple-system, sans-serif"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="{StaticResource MonochromeBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource MonochromeTextBrush}"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <!-- Global TextBlock Style.
             No se fija Foreground aquí: los TextBlock generados dentro de los botones
             deben heredar Button.Foreground. Si se fija aquí, el texto de los botones
             oscuros queda oscuro y deja de verse. -->
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI, sans-serif"/>
        </Style>

        <!-- Global TextBox Style -->
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="0,4,0,12"/>
            <Setter Property="Background" Value="{StaticResource MonochromeSurfaceBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource MonochromeTextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource MonochromeBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="BoxBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"
                                          Padding="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BoxBorder" Property="BorderBrush" Value="{StaticResource MonochromeBorderStrongBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="BoxBorder" Property="BorderBrush" Value="{StaticResource MonochromePrimaryBrush}"/>
                                <Setter TargetName="BoxBorder" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BoxBorder" Property="Background" Value="{StaticResource MonochromeSurfaceAltBrush}"/>
                                <Setter TargetName="BoxBorder" Property="BorderBrush" Value="{StaticResource MonochromeBorderBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource MonochromeMutedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Validation.ErrorTemplate">
                <Setter.Value>
                    <ControlTemplate>
                        <StackPanel>
                            <AdornedElementPlaceholder x:Name="ErrorPlaceholder"/>
                            <TextBlock Text="{Binding [0].ErrorContent}"
                                       Foreground="{StaticResource MonochromeSecondaryBrush}"
                                       FontSize="11" Margin="2,2,0,0"
                                       FontStyle="Italic"/>
                        </StackPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Global PasswordBox Style -->
        <Style TargetType="PasswordBox">
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="0,4,0,12"/>
            <Setter Property="Background" Value="{StaticResource MonochromeSurfaceBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource MonochromeTextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource MonochromeBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="PasswordBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"
                                          Padding="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PasswordBorder" Property="BorderBrush" Value="{StaticResource MonochromeBorderStrongBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="PasswordBorder" Property="BorderBrush" Value="{StaticResource MonochromePrimaryBrush}"/>
                                <Setter TargetName="PasswordBorder" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="PasswordBorder" Property="Background" Value="{StaticResource MonochromeSurfaceAltBrush}"/>
                                <Setter TargetName="PasswordBorder" Property="BorderBrush" Value="{StaticResource MonochromeBorderBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource MonochromeMutedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Global ComboBox Style -->
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="0,4,0,12"/>
            <Setter Property="Background" Value="{StaticResource MonochromeSurfaceBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource MonochromeTextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource MonochromeBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- Global DatePicker Style -->
        <Style TargetType="DatePicker">
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Margin" Value="0,4,0,12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
            <EventSetter Event="Loaded" Handler="DatePicker_Loaded"/>
        </Style>

        <!-- Primary Button Style (Default Button) -->
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="Background" Value="{StaticResource MonochromePrimaryBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource MonochromeSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource MonochromePrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource MonochromeHoverBrush}"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource MonochromeHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#09090B"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#09090B"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource MonochromeSurfaceAltBrush}"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource MonochromeBorderBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource MonochromeMutedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Button Style -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="Background" Value="{StaticResource MonochromeSurfaceBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource MonochromeTextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource MonochromeBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="SecBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SecBorder" Property="Background" Value="{StaticResource MonochromeSurfaceAltBrush}"/>
                                <Setter TargetName="SecBorder" Property="BorderBrush" Value="{StaticResource MonochromeBorderStrongBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="SecBorder" Property="Background" Value="{StaticResource MonochromeBorderBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="SecBorder" Property="Background" Value="{StaticResource MonochromeSurfaceAltBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource MonochromeMutedBrush}"/>
                                <Setter TargetName="SecBorder" Property="BorderBrush" Value="{StaticResource MonochromeBorderBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Danger Outline Button Style (Monochromatic) -->
        <Style x:Key="DangerOutlineButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Foreground" Value="{StaticResource MonochromeSecondaryBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource MonochromeTextBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource MonochromePrimaryBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Ghost Button Style -->
        <Style x:Key="GhostButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource MonochromeSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="GhostBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="GhostBorder" Property="Background" Value="{StaticResource MonochromeSurfaceAltBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource MonochromeTextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="GhostBorder" Property="Background" Value="{StaticResource MonochromeBorderBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource MonochromeMutedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sidebar Navigation ListBox and Item Styles -->
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource MonochromeSidebarMutedBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource MonochromeSidebarHoverBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource MonochromeSidebarTextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource MonochromeSidebarSelectedBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource MonochromeSidebarTextBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DataGrid Styles (Linear / Notion table styling) -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{StaticResource MonochromeSurfaceBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource MonochromeTextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource MonochromeBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowHeight" Value="40"/>
            <Setter Property="ColumnHeaderHeight" Value="38"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource MonochromeBorderLightBrush}"/>
            <Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <!-- La edición de registros se hace únicamente desde los botones "Editar ...". -->
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="EnableRowVirtualization" Value="True"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource MonochromeSurfaceAltBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource MonochromeSecondaryBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="BorderBrush" Value="{StaticResource MonochromeBorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Foreground" Value="{StaticResource MonochromeTextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{StaticResource MonochromeTextBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="{StaticResource MonochromeSurfaceBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource MonochromeTextBrush}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F8F9FA"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource MonochromeSurfaceAltBrush}"/>
                    <Setter Property="Foreground" Value="{StaticResource MonochromeTextBrush}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Modern Loading Spinner Template -->
        <ControlTemplate x:Key="SpinnerTemplate">
            <Ellipse Width="20" Height="20"
                     Stroke="{StaticResource MonochromePrimaryBrush}"
                     StrokeThickness="2.5"
                     StrokeDashArray="0.7 2.0"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center">
                <Ellipse.RenderTransform>
                    <RotateTransform x:Name="SpinnerRotation" CenterX="10" CenterY="10"/>
                </Ellipse.RenderTransform>
                <Ellipse.Triggers>
                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                        <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever">
                                <DoubleAnimation Storyboard.TargetName="SpinnerRotation"
                                                 Storyboard.TargetProperty="Angle"
                                                 From="0" To="360" Duration="0:0:0.85"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Ellipse.Triggers>
            </Ellipse>
        </ControlTemplate>

        <!-- Metric Card Style (Used in Dashboard) -->
        <Style x:Key="MetricCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource MonochromeSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource MonochromeBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="18,16"/>
            <Setter Property="Margin" Value="0,0,12,12"/>
        </Style>

        <!-- Panel Card Style -->
        <Style x:Key="PanelCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource MonochromeSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource MonochromeBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="20"/>
        </Style>
    </Application.Resources>
</Application>
