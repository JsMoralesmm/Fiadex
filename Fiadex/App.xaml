<Application x:Class="Fiadex.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:presentationOptions="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
             xmlns:local="clr-namespace:Fiadex">
    <Application.Resources>
        <!-- Value Converters -->
        <local:CountToVisibilityConverter x:Key="CountToVisibility"/>
        <local:InverseCountToVisibilityConverter x:Key="InverseCountToVisibility"/>
        <local:BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <local:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility"/>
        <local:InverseBooleanConverter x:Key="InverseBool"/>
        <local:StringToVisibilityConverter x:Key="StringToVisibility"/>
        <local:BalanceStatusConverter x:Key="BalanceStatus"/>
        <local:SidebarWidthConverter x:Key="SidebarWidth"/>
        <local:SidebarGridColumnConverter x:Key="SidebarGridColumn"/>
        <local:SidebarColumnSpanConverter x:Key="SidebarColumnSpan"/>
        <local:SidebarIconMarginConverter x:Key="SidebarIconMargin"/>
        <local:SidebarNavIconColumnConverter x:Key="SidebarNavIconColumn"/>
        <local:SidebarNavPaddingConverter x:Key="SidebarNavPadding"/>
        <local:SidebarActionIconMarginConverter x:Key="SidebarActionIconMargin"/>
        <local:SidebarActionAlignmentConverter x:Key="SidebarActionAlignment"/>
        <local:SidebarActionPaddingConverter x:Key="SidebarActionPadding"/>
        <local:RoleToAlignmentConverter x:Key="RoleToAlignment"/>
        <local:RoleToBubbleBackgroundConverter x:Key="RoleToBubbleBg"/>
        <local:RoleToBubbleForegroundConverter x:Key="RoleToBubbleFg"/>
        <local:RoleToBubbleBorderConverter x:Key="RoleToBubbleBorder"/>
        <local:RoleToSenderNameConverter x:Key="RoleToSenderName"/>
        <local:RoleToCornerRadiusConverter x:Key="RoleToCornerRadius"/>
        <local:RoleToMarginConverter x:Key="RoleToMargin"/>

        <!-- Monochromatic Design System Tokens (Linear / Notion inspired) -->
        <Color x:Key="MonochromeBgColor">#F8F9FA</Color>
        <Color x:Key="MonochromeSurfaceColor">#FFFFFF</Color>
        <Color x:Key="MonochromeSurfaceAltColor">#F3F4F6</Color>
        <Color x:Key="MonochromeBorderColor">#E4E4E7</Color>
        <Color x:Key="MonochromeBorderLightColor">#F0F0F2</Color>
        <Color x:Key="MonochromeBorderStrongColor">#D1D5DB</Color>
        <Color x:Key="MonochromePrimaryColor">#18181B</Color>
        <Color x:Key="MonochromeHoverColor">#27272A</Color>
        <Color x:Key="MonochromeSecondaryColor">#62626A</Color>
        <Color x:Key="MonochromeMutedColor">#6C6C74</Color>
        <Color x:Key="MonochromeTextColor">#18181B</Color>
        <Color x:Key="MonochromeDisabledColor">#D4D4D8</Color>
        <Color x:Key="MonochromeOnPrimaryColor">#FFFFFF</Color>

        <!-- Sidebar Tokens -->
        <Color x:Key="MonochromeSidebarColor">#111113</Color>
        <Color x:Key="MonochromeSidebarBorderColor">#222226</Color>
        <Color x:Key="MonochromeSidebarTextColor">#F4F4F5</Color>
        <Color x:Key="MonochromeSidebarMutedColor">#8E8E98</Color>
        <Color x:Key="MonochromeSidebarHoverColor">#1F1F24</Color>
        <Color x:Key="MonochromeSidebarSelectedColor">#27272E</Color>

        <!-- Solid Color Brushes -->
        <SolidColorBrush presentationOptions:Freeze="False" x:Key="MonochromeBackgroundBrush" Color="{DynamicResource MonochromeBgColor}"/>
        <SolidColorBrush presentationOptions:Freeze="False" x:Key="MonochromeSurfaceBrush" Color="{DynamicResource MonochromeSurfaceColor}"/>
        <SolidColorBrush presentationOptions:Freeze="False" x:Key="MonochromeSurfaceAltBrush" Color="{DynamicResource MonochromeSurfaceAltColor}"/>
        <SolidColorBrush presentationOptions:Freeze="False" x:Key="MonochromeBorderBrush" Color="{DynamicResource MonochromeBorderColor}"/>
        <SolidColorBrush presentationOptions:Freeze="False" x:Key="MonochromeBorderLightBrush" Color="{DynamicResource MonochromeBorderLightColor}"/>
        <SolidColorBrush presentationOptions:Freeze="False" x:Key="MonochromeBorderStrongBrush" Color="{DynamicResource MonochromeBorderStrongColor}"/>
        <SolidColorBrush presentationOptions:Freeze="False" x:Key="MonochromePrimaryBrush" Color="{DynamicResource MonochromePrimaryColor}"/>
        <SolidColorBrush presentationOptions:Freeze="False" x:Key="MonochromeHoverBrush" Color="{DynamicResource MonochromeHoverColor}"/>
        <SolidColorBrush presentationOptions:Freeze="False" x:Key="MonochromeSecondaryBrush" Color="{DynamicResource MonochromeSecondaryColor}"/>
        <SolidColorBrush presentationOptions:Freeze="False" x:Key="MonochromeMutedBrush" Color="{DynamicResource MonochromeMutedColor}"/>
        <SolidColorBrush presentationOptions:Freeze="False" x:Key="MonochromeTextBrush" Color="{DynamicResource MonochromeTextColor}"/>
        <SolidColorBrush presentationOptions:Freeze="False" x:Key="MonochromeDisabledBrush" Color="{DynamicResource MonochromeDisabledColor}"/>
        <SolidColorBrush presentationOptions:Freeze="False" x:Key="MonochromeOnPrimaryBrush" Color="{DynamicResource MonochromeOnPrimaryColor}"/>

        <!-- Sidebar Brushes -->
        <SolidColorBrush presentationOptions:Freeze="False" x:Key="MonochromeSidebarBrush" Color="{DynamicResource MonochromeSidebarColor}"/>
        <SolidColorBrush presentationOptions:Freeze="False" x:Key="MonochromeSidebarBorderBrush" Color="{DynamicResource MonochromeSidebarBorderColor}"/>
        <SolidColorBrush presentationOptions:Freeze="False" x:Key="MonochromeSidebarTextBrush" Color="{DynamicResource MonochromeSidebarTextColor}"/>
        <SolidColorBrush presentationOptions:Freeze="False" x:Key="MonochromeSidebarMutedBrush" Color="{DynamicResource MonochromeSidebarMutedColor}"/>
        <SolidColorBrush presentationOptions:Freeze="False" x:Key="MonochromeSidebarHoverBrush" Color="{DynamicResource MonochromeSidebarHoverColor}"/>
        <SolidColorBrush presentationOptions:Freeze="False" x:Key="MonochromeSidebarSelectedBrush" Color="{DynamicResource MonochromeSidebarSelectedColor}"/>

        <!-- Tamaños de texto (los ajusta AccessibilityService) -->
        <sys:Double x:Key="FsXs">10.5</sys:Double>
        <sys:Double x:Key="FsSm">11.5</sys:Double>
        <sys:Double x:Key="FsMd">12.5</sys:Double>
        <sys:Double x:Key="FsBase">13</sys:Double>

        <!-- Tipografía global seleccionable desde Accesibilidad -->
        <FontFamily x:Key="AppFontFamily">Segoe UI Variable Text, Segoe UI, -apple-system, sans-serif</FontFamily>

        <!-- Indicador de foco: fino por defecto, reforzado si se activa "Foco visible" -->
        <Visibility x:Key="SpinnerAnimationVisibility">Visible</Visibility>
        <Visibility x:Key="SpinnerStaticVisibility">Collapsed</Visibility>

        <Style x:Key="DefaultFocusVisualStyle" TargetType="Control">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Rectangle SnapsToDevicePixels="True"
                                   Stroke="{DynamicResource MonochromeSecondaryBrush}"
                                   StrokeThickness="1"
                                   StrokeDashArray="1 2"
                                   Margin="-2"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StrongFocusVisualStyle" TargetType="Control">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Rectangle SnapsToDevicePixels="True"
                                   Stroke="{DynamicResource MonochromeTextBrush}"
                                   StrokeThickness="2.5"
                                   Margin="-3"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="VeryStrongFocusVisualStyle" TargetType="Control">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Rectangle SnapsToDevicePixels="True"
                                   Stroke="{DynamicResource MonochromeTextBrush}"
                                   StrokeThickness="3"
                                   Margin="-4"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AppFocusVisualStyle" TargetType="Control" BasedOn="{StaticResource DefaultFocusVisualStyle}"/>

        <!-- Global Window Style -->
        <Style TargetType="Window">
            <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
            <Setter Property="FontSize" Value="{DynamicResource FsBase}"/>
            <Setter Property="Background" Value="{DynamicResource MonochromeBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource MonochromeTextBrush}"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <!-- Global TextBlock Style.
             No se fija Foreground aquí: los TextBlock generados dentro de los botones
             deben heredar Button.Foreground. Si se fija aquí, el texto de los botones
             oscuros queda oscuro y deja de verse. -->
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
        </Style>

        <!-- Global TextBox Style -->
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="0,4,0,12"/>
            <Setter Property="Background" Value="{DynamicResource MonochromeSurfaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource MonochromeTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource MonochromeBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="{DynamicResource FsBase}"/>
            <Setter Property="FocusVisualStyle" Value="{DynamicResource AppFocusVisualStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="BoxBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"
                                          Padding="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BoxBorder" Property="BorderBrush" Value="{DynamicResource MonochromeBorderStrongBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="BoxBorder" Property="BorderBrush" Value="{DynamicResource MonochromePrimaryBrush}"/>
                                <Setter TargetName="BoxBorder" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BoxBorder" Property="Background" Value="{DynamicResource MonochromeSurfaceAltBrush}"/>
                                <Setter TargetName="BoxBorder" Property="BorderBrush" Value="{DynamicResource MonochromeBorderBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource MonochromeMutedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Validation.ErrorTemplate">
                <Setter.Value>
                    <ControlTemplate>
                        <StackPanel>
                            <AdornedElementPlaceholder x:Name="ErrorPlaceholder"/>
                            <TextBlock Text="{Binding [0].ErrorContent}"
                                       Foreground="{DynamicResource MonochromeSecondaryBrush}"
                                       FontSize="11" Margin="2,2,0,0"
                                       FontStyle="Italic"/>
                        </StackPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Global PasswordBox Style -->
        <Style TargetType="PasswordBox">
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="0,4,0,12"/>
            <Setter Property="Background" Value="{DynamicResource MonochromeSurfaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource MonochromeTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource MonochromeBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="{DynamicResource FsBase}"/>
            <Setter Property="FocusVisualStyle" Value="{DynamicResource AppFocusVisualStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="PasswordBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"
                                          Padding="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PasswordBorder" Property="BorderBrush" Value="{DynamicResource MonochromeBorderStrongBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="PasswordBorder" Property="BorderBrush" Value="{DynamicResource MonochromePrimaryBrush}"/>
                                <Setter TargetName="PasswordBorder" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="PasswordBorder" Property="Background" Value="{DynamicResource MonochromeSurfaceAltBrush}"/>
                                <Setter TargetName="PasswordBorder" Property="BorderBrush" Value="{DynamicResource MonochromeBorderBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource MonochromeMutedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Global ComboBox Style.
             La plantilla de WPF dibuja el desplegable con SystemColors (blanco),
             que no sigue la paleta: en el tema Negro el texto queda blanco sobre
             blanco. Por eso se usa una plantilla propia que toma los colores
             de la paleta de la aplicación. -->
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="0,4,0,12"/>
            <Setter Property="Background" Value="{DynamicResource MonochromeSurfaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource MonochromeTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource MonochromeBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="{DynamicResource FsBase}"/>
            <Setter Property="FocusVisualStyle" Value="{DynamicResource AppFocusVisualStyle}"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid SnapsToDevicePixels="True">
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Placement="Bottom"
                                   PopupAnimation="None"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Margin="0,2">
                                <Border x:Name="DropDownBorder"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        SnapsToDevicePixels="True">
                                    <ScrollViewer x:Name="DropDownScrollViewer"
                                                  Padding="4"
                                                  CanContentScroll="True"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <ItemsPresenter x:Name="ItemsPresenter"
                                                        KeyboardNavigation.DirectionalNavigation="Contained"
                                                        SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                            <Border x:Name="ComboBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6"
                                    SnapsToDevicePixels="True">
                                <Grid Margin="{TemplateBinding Padding}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="22"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter x:Name="ContentSite"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                      HorizontalAlignment="Left"
                                                      IsHitTestVisible="False"
                                                      TextElement.Foreground="{TemplateBinding Foreground}"/>
                                    <Path x:Name="Arrow"
                                          Grid.Column="1"
                                          Data="M 0 0 L 5 5 L 10 0 Z"
                                          Fill="{TemplateBinding Foreground}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <ToggleButton x:Name="DropDownButton"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          Focusable="False"
                                          ClickMode="Press"
                                          Cursor="Hand">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{DynamicResource MonochromeBorderStrongBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{DynamicResource MonochromePrimaryBrush}"/>
                                <Setter TargetName="ComboBorder" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{DynamicResource MonochromePrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ComboBorder" Property="Background" Value="{DynamicResource MonochromeSurfaceAltBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource MonochromeMutedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Global ComboBoxItem Style: el texto y el fondo siguen siempre la paleta. -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource MonochromeTextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{DynamicResource AppFocusVisualStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource MonochromeSurfaceAltBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource MonochromeTextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource MonochromeSurfaceAltBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource MonochromeTextBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource MonochromeMutedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Global DatePicker Style -->
        <Style TargetType="DatePicker">
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Margin" Value="0,4,0,12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="{DynamicResource FsBase}"/>
            <Setter Property="FocusVisualStyle" Value="{DynamicResource AppFocusVisualStyle}"/>
            <EventSetter Event="Loaded" Handler="DatePicker_Loaded"/>
        </Style>

        <!-- Primary Button Style (Default Button) -->
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="Background" Value="{DynamicResource MonochromePrimaryBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource MonochromeOnPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource MonochromePrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="{DynamicResource FsMd}"/>
            <Setter Property="FocusVisualStyle" Value="{DynamicResource AppFocusVisualStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource MonochromeHoverBrush}"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource MonochromeHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource MonochromeHoverBrush}"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource MonochromeHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource MonochromeSurfaceAltBrush}"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource MonochromeBorderBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource MonochromeMutedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Button Style -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="Background" Value="{DynamicResource MonochromeSurfaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource MonochromeTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource MonochromeBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="{DynamicResource FsMd}"/>
            <Setter Property="FocusVisualStyle" Value="{DynamicResource AppFocusVisualStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="SecBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SecBorder" Property="Background" Value="{DynamicResource MonochromeSurfaceAltBrush}"/>
                                <Setter TargetName="SecBorder" Property="BorderBrush" Value="{DynamicResource MonochromeBorderStrongBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="SecBorder" Property="Background" Value="{DynamicResource MonochromeBorderBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="SecBorder" Property="Background" Value="{DynamicResource MonochromeSurfaceAltBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource MonochromeMutedBrush}"/>
                                <Setter TargetName="SecBorder" Property="BorderBrush" Value="{DynamicResource MonochromeBorderBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Danger Outline Button Style (Monochromatic) -->
        <Style x:Key="DangerOutlineButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Foreground" Value="{DynamicResource MonochromeSecondaryBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource MonochromeTextBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource MonochromePrimaryBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Ghost Button Style -->
        <Style x:Key="GhostButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource MonochromeSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="{DynamicResource FsSm}"/>
            <Setter Property="FocusVisualStyle" Value="{DynamicResource AppFocusVisualStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="GhostBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="GhostBorder" Property="Background" Value="{DynamicResource MonochromeSurfaceAltBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource MonochromeTextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="GhostBorder" Property="Background" Value="{DynamicResource MonochromeBorderBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource MonochromeMutedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sidebar Navigation ListBox and Item Styles -->
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource MonochromeSidebarMutedBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="{DynamicResource FsBase}"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="FocusVisualStyle" Value="{DynamicResource AppFocusVisualStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource MonochromeSidebarHoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource MonochromeSidebarTextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource MonochromeSidebarSelectedBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource MonochromeSidebarTextBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DataGrid Styles (Linear / Notion table styling) -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{DynamicResource MonochromeSurfaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource MonochromeTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource MonochromeBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowHeight" Value="40"/>
            <Setter Property="ColumnHeaderHeight" Value="38"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource MonochromeBorderLightBrush}"/>
            <Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <!-- La edición de registros se hace únicamente desde los botones "Editar ...". -->
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="EnableRowVirtualization" Value="True"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource MonochromeSurfaceAltBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource MonochromeSecondaryBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="{DynamicResource FsXs}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource MonochromeBorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Foreground" Value="{DynamicResource MonochromeTextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{DynamicResource MonochromeTextBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="{DynamicResource MonochromeSurfaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource MonochromeTextBrush}"/>
            <Setter Property="FontSize" Value="{DynamicResource FsMd}"/>
            <Setter Property="FocusVisualStyle" Value="{DynamicResource AppFocusVisualStyle}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource MonochromeSurfaceAltBrush}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource MonochromeSurfaceAltBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource MonochromeTextBrush}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Modern Loading Spinner Template -->
        <ControlTemplate x:Key="SpinnerTemplate">
            <Grid>
                <Ellipse Width="20" Height="20"
                         Stroke="{DynamicResource MonochromePrimaryBrush}"
                         StrokeThickness="2.5"
                         StrokeDashArray="0.7 2.0"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Visibility="{DynamicResource SpinnerAnimationVisibility}">
                    <Ellipse.RenderTransform>
                        <RotateTransform x:Name="SpinnerRotation" CenterX="10" CenterY="10"/>
                    </Ellipse.RenderTransform>
                    <Ellipse.Triggers>
                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetName="SpinnerRotation"
                                                     Storyboard.TargetProperty="Angle"
                                                     From="0" To="360" Duration="0:0:0.85"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Ellipse.Triggers>
                </Ellipse>
                <!-- Sin animación cuando está activo "Reducir movimiento". -->
                <Ellipse Width="20" Height="20"
                         Stroke="{DynamicResource MonochromePrimaryBrush}"
                         StrokeThickness="2.5"
                         StrokeDashArray="0.7 2.0"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Visibility="{DynamicResource SpinnerStaticVisibility}"/>
            </Grid>
        </ControlTemplate>

        <!-- Metric Card Style (Used in Dashboard) -->
        <Style x:Key="MetricCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource MonochromeSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource MonochromeBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="18,16"/>
            <Setter Property="Margin" Value="0,0,12,12"/>
        </Style>

        <!-- Panel Card Style -->
        <Style x:Key="PanelCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource MonochromeSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource MonochromeBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="20"/>
        </Style>
    </Application.Resources>
</Application>

