<Window x:Class="Fiadex.ModalDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource ModalWindowStyle}"
        Title="Confirmar"
        Height="310" Width="470"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel VerticalAlignment="Center" Margin="0,0,0,8">
                <TextBlock Text="Fiadex" FontSize="{DynamicResource FsXs}" FontWeight="SemiBold"
                           Foreground="{DynamicResource MonochromeMutedBrush}"/>
                <TextBlock x:Name="HeadingText" Text="Confirme la acción"
                           FontSize="20" FontWeight="SemiBold"
                           Foreground="{DynamicResource MonochromeTextBrush}"
                           Margin="0,6,0,10"/>
                <TextBlock x:Name="MessageText"
                           FontSize="{DynamicResource FsBase}"
                           Foreground="{DynamicResource MonochromeSecondaryBrush}"
                           TextWrapping="Wrap" LineHeight="21"/>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Height="1" Background="{DynamicResource MonochromeBorderBrush}" Margin="0,0,0,16"/>
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton"
                        Content="Cancelar"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Width="110" Height="40" Margin="0"
                        IsCancel="True"
                        Click="CancelClick"
                        AutomationProperties.Name="Cancelar"/>
                <Button x:Name="ConfirmButton"
                        Content="Confirmar"
                        Width="130" Height="40" Margin="8,0,0,0"
                        IsDefault="True"
                        Click="ConfirmClick"
                        AutomationProperties.Name="Confirmar acción"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
