<Window x:Class="Fiadex.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Fiadex"
        mc:Ignorable="d"
        Title="Fiadex — Control de Préstamos y Cartera"
        Height="730" Width="1180"
        MinHeight="600" MinWidth="920"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource MonochromeBackgroundBrush}">

    <Window.Resources>
        <!-- Icon Geometries -->
        <Geometry x:Key="IconDashboard">M3 3h7v7H3V3zm11 0h7v7h-7V3zm0 11h7v7h-7v-7zm-11 0h7v7H3v-7z</Geometry>
        <Geometry x:Key="IconPersonas">M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z</Geometry>
        <Geometry x:Key="IconPrestamos">M20 4H4c-1.11 0-1.99.89-1.99 2L2 18c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V6c0-1.11-.89-2-2-2zm0 14H4v-6h16v6zm0-10H4V6h16v2z</Geometry>
        <Geometry x:Key="IconHistorial">M13 3a9 9 0 0 0-9 9H1l3.89 3.89.07.14L9 12H6c0-3.87 3.13-7 7-7s7 3.13 7 7-3.13 7-7 7c-1.93 0-3.68-.79-4.94-2.06l-1.42 1.42A8.954 8.954 0 0 0 13 21a9 9 0 0 0 0-18zm-1 5v5l4.28 2.54.72-1.21-3.5-2.08V8H12z</Geometry>
        <Geometry x:Key="IconAbonos">M19 14V6c0-1.1-.9-2-2-2H3c-1.1 0-2 .9-2 2v8c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2zm-2 0H3V6h14v8zm5-7v11c0 1.1-.9 2-2 2H4v-2h16V7h2z</Geometry>
        <Geometry x:Key="IconIA">M19 9l1.25-2.75L23 5l-2.75-1.25L19 1l-1.25 2.75L15 5l2.75 1.25L19 9zm-7.5.5L9 4 6.5 9.5 1 12l5.5 2.5L9 20l2.5-5.5L17 12l-5.5-2.5zM19 15l-1.25 2.75L15 19l2.75 1.25L19 23l1.25-2.75L23 19l-2.75-1.25L19 15z</Geometry>
        <Geometry x:Key="IconLogo">M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5</Geometry>
        <Geometry x:Key="IconHamburger">M3 6h18v2H3V6zm0 5h18v2H3v-2zm0 5h18v2H3v-2z</Geometry>
        <Geometry x:Key="IconSearch">M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z</Geometry>
        <Geometry x:Key="IconEdit">M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z</Geometry>
        <Geometry x:Key="IconDelete">M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z</Geometry>
        <Geometry x:Key="IconSend">M2.01 21L23 12 2.01 3 2 10l15 2-15 2z</Geometry>
        <Geometry x:Key="IconCheck">M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z</Geometry>
        <Geometry x:Key="IconDocument">M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z</Geometry>
        <Geometry x:Key="IconRefresh">M17.65 6.35A7.958 7.958 0 0 0 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08A5.99 5.99 0 0 1 12 18c-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z</Geometry>
        <Geometry x:Key="IconKey">M12.65 10C11.83 7.67 9.61 6 7 6c-3.31 0-6 2.69-6 6s2.69 6 6 6c2.61 0 4.83-1.67 5.65-4H17v4h4v-4h2v-4H12.65zM7 14c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2z</Geometry>
        <Geometry x:Key="IconLogout">M10.09 15.59L11.5 17l5-5-5-5-1.41 1.41L12.67 11H3v2h9.67l-2.58 2.59zM19 3H5c-1.11 0-2 .9-2 2v4h2V5h14v14H5v-4H3v4c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2z</Geometry>
        <Geometry x:Key="IconAccessibility">M12 2a2 2 0 1 1 0 4 2 2 0 0 1 0-4zm0 5c-1.5 0-2.8.8-3.5 2H5v2h3v6h2v-5h1v5h2v-6h3V9h-3.5A4 4 0 0 0 12 7z</Geometry>

        <!-- Sidebar Navigation Item Template -->
        <Style x:Key="SidebarNavItemStyle" TargetType="ListBoxItem">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource MonochromeSidebarMutedBrush}"/>
            <Setter Property="FontSize" Value="{DynamicResource FsBase}"/>
            <Setter Property="FocusVisualStyle" Value="{DynamicResource AppFocusVisualStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="ItemBorder"
                                    Background="Transparent"
                                    CornerRadius="10"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Border>
                            <Border x:Name="SelectedBar" Width="3" Height="18"
                                    HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Background="{DynamicResource MonochromePrimaryBrush}"
                                    CornerRadius="2" Opacity="0" Margin="2,0,0,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource MonochromeSidebarHoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource MonochromeSidebarTextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource MonochromeSidebarSelectedBrush}"/>
                                <Setter TargetName="SelectedBar" Property="Opacity" Value="1"/>
                                <Setter Property="Foreground" Value="{DynamicResource MonochromeSidebarTextBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarToggleButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="TglBorder" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TglBorder" Property="Background" Value="{DynamicResource MonochromeSidebarHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource MonochromeSidebarBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource MonochromeSidebarBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource MonochromeSidebarTextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="{DynamicResource FsSm}"/>
            <Setter Property="FocusVisualStyle" Value="{DynamicResource AppFocusVisualStyle}"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10" Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource MonochromeSidebarHoverBrush}"/>
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="{DynamicResource MonochromeSidebarSelectedBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource MonochromeSidebarTextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Banner Action Button: mismo hover monocromático que el cierre del banner. -->
        <Style x:Key="BannerActionButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="{DynamicResource FsSm}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource MonochromeOnPrimaryBrush}"/>
            <Setter Property="FocusVisualStyle" Value="{DynamicResource AppFocusVisualStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="ActionHover" CornerRadius="5"
                                    Background="{DynamicResource MonochromeOnPrimaryBrush}" Opacity="0"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ActionHover" Property="Opacity" Value="0.16"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ActionHover" Property="Opacity" Value="0.26"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding IsSidebarCollapsed, Converter={StaticResource SidebarWidth}}"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ========================================== -->
        <!-- SIDEBAR (Barra lateral elegante y moderna) -->
        <!-- ========================================== -->
        <Border Grid.Column="0"
                Background="{DynamicResource MonochromeSidebarBrush}"
                BorderBrush="{DynamicResource MonochromeSidebarBorderBrush}"
                BorderThickness="0,0,1,0"
                Padding="12,14"
                MouseEnter="Sidebar_MouseEnter"
                MouseLeave="Sidebar_MouseLeave">
            <Border.Resources>
                <!-- Scoped TextBlock style inside the Sidebar: ensures all sidebar text defaults to high-contrast light silver -->
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{DynamicResource MonochromeSidebarTextBrush}"/>
                    <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
                </Style>
            </Border.Resources>
            <DockPanel>
                <!-- TOP HEADER: Logo & Collapse Button -->
                <StackPanel DockPanel.Dock="Top">
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Brand Logo Monogram -->
                        <Border Width="36" Height="36" CornerRadius="10"
                                Background="{DynamicResource MonochromeSidebarSelectedBrush}"
                                BorderBrush="{DynamicResource MonochromeSidebarBorderBrush}"
                                BorderThickness="1" HorizontalAlignment="Left"
                                Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVisibility}}">
                            <Path Data="{StaticResource IconLogo}" Fill="{DynamicResource MonochromeSidebarTextBrush}"
                                  Stretch="Uniform" Width="17" Height="17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <!-- Brand Title & Tagline (Visible only when expanded) -->
                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                                    Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVisibility}}">
                            <TextBlock Text="FIADEX" Foreground="{DynamicResource MonochromeSidebarTextBrush}" FontSize="15" FontWeight="Bold"/>
                            <TextBlock Text="Control de Cartera" Foreground="{DynamicResource MonochromeSidebarMutedBrush}" FontSize="11" Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- Hamburger Toggle Button -->
                        <Button x:Name="HamburgerButton"
                                Grid.Column="{Binding IsSidebarCollapsed, Converter={StaticResource SidebarGridColumn}}"
                                Grid.ColumnSpan="{Binding IsSidebarCollapsed, Converter={StaticResource SidebarColumnSpan}}"
                                Style="{StaticResource SidebarToggleButtonStyle}"
                                HorizontalAlignment="Center"
                                Width="30" Height="30"
                                ToolTip="Mostrar u ocultar menú"
                                AutomationProperties.Name="Mostrar u ocultar menú"
                                Command="{Binding ToggleSidebarCommand}">
                            <Path Data="{StaticResource IconHamburger}" Fill="{DynamicResource MonochromeSidebarTextBrush}" Stretch="Uniform" Width="14" Height="14"/>
                        </Button>
                    </Grid>

                    <!-- Pin / Unpin Mode Pill (When expanded) -->
                    <Border Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVisibility}}"
                            Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource SidebarActionButtonStyle}"
                                    Height="28" Padding="8,2"
                                    ToolTip="Mantener el menú expandido"
                                    AutomationProperties.Name="Fijar menú"
                                    Command="{Binding TogglePinCommand}"
                                    Visibility="{Binding IsSidebarPinned, Converter={StaticResource InverseBoolToVisibility}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📌" FontSize="10" Margin="0,0,4,0"/>
                                    <TextBlock Text="Fijar menú" FontSize="11" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SidebarActionButtonStyle}"
                                    Height="28" Padding="8,2"
                                    ToolTip="Permitir ocultar el menú al salir"
                                    AutomationProperties.Name="Soltar menú"
                                    Command="{Binding TogglePinCommand}"
                                    Visibility="{Binding IsSidebarPinned, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔓" FontSize="10" Margin="0,0,4,0"/>
                                    <TextBlock Text="Soltar menú" FontSize="11" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Divider -->
                    <Border Height="1" Background="{DynamicResource MonochromeSidebarBorderBrush}" Margin="0,0,0,10"/>
                </StackPanel>

                <!-- BOTTOM FOOTER: User Profile & Account Actions -->
                <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                    <Border Height="1" Background="{DynamicResource MonochromeSidebarBorderBrush}" Margin="0,0,0,10"/>

                    <!-- User Info Card (Expanded) -->
                    <Grid Margin="2,0,0,10"
                          Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="32" Height="32" CornerRadius="16"
                                Background="{DynamicResource MonochromeSidebarSelectedBrush}"
                                BorderBrush="{DynamicResource MonochromeSidebarBorderBrush}" BorderThickness="1"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="AD" Foreground="{DynamicResource MonochromeSidebarTextBrush}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Administrador" Foreground="{DynamicResource MonochromeSidebarTextBrush}" FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock Text="En línea" Foreground="{DynamicResource MonochromeSidebarMutedBrush}" FontSize="11"/>
                        </StackPanel>
                    </Grid>

                    <!-- Accesibilidad: abre un submenú junto a la barra lateral -->
                    <Button x:Name="AccessibilityButton"
                            Style="{StaticResource SidebarActionButtonStyle}"
                            Click="AccessibilityClick"
                            HorizontalContentAlignment="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource SidebarActionAlignment}}"
                            Padding="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource SidebarActionPadding}}"
                            ToolTip="Accesibilidad"
                            AutomationProperties.AutomationId="AccessibilityButton"
                            AutomationProperties.Name="Abrir opciones de accesibilidad"
                            Margin="0,0,0,4">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconAccessibility}"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Stretch="Uniform" Width="12" Height="12"
                                  Margin="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource SidebarActionIconMargin}}"/>
                            <TextBlock Text="Accesibilidad"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                       Visibility="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolToVisibility}}"/>
                        </StackPanel>
                    </Button>

                    <!-- Account Buttons (visibles también en el menú colapsado) -->
                    <StackPanel>
                        <Button Style="{StaticResource SidebarActionButtonStyle}"
                                Click="ChangePasswordClick"
                                HorizontalContentAlignment="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource SidebarActionAlignment}}"
                                Padding="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource SidebarActionPadding}}"
                                ToolTip="Cambiar clave"
                                AutomationProperties.Name="Cambiar contraseña">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconKey}"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Stretch="Uniform" Width="12" Height="12"
                                      Margin="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource SidebarActionIconMargin}}"/>
                                <TextBlock Text="Cambiar clave"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                           Visibility="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolToVisibility}}"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SidebarActionButtonStyle}"
                                Margin="0,4,0,0"
                                Click="LogoutClick"
                                HorizontalContentAlignment="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource SidebarActionAlignment}}"
                                Padding="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource SidebarActionPadding}}"
                                ToolTip="Cerrar sesión"
                                AutomationProperties.Name="Cerrar sesión">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconLogout}"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Stretch="Uniform" Width="12" Height="12"
                                      Margin="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource SidebarActionIconMargin}}"/>
                                <TextBlock Text="Cerrar sesión"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                           Visibility="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolToVisibility}}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>

                <!-- CENTER: Navigation Menu ListBox -->
                <ListBox x:Name="Navigation"
                         SelectedIndex="0"
                         SelectionChanged="Navigation_SelectionChanged"
                         AutomationProperties.Name="Navegación principal">
                    <!-- Item 0: Dashboard -->
                    <ListBoxItem Style="{StaticResource SidebarNavItemStyle}" Tag="Dashboard" ToolTip="Dashboard"
                                 Padding="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource SidebarNavPadding}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource SidebarNavIconColumn}}"
                                  Grid.ColumnSpan="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource SidebarColumnSpan}}"
                                  Data="{StaticResource IconDashboard}"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                  Stretch="Uniform" Width="15" Height="15"
                                  Margin="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource SidebarIconMargin}}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Dashboard"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                       FontWeight="{Binding FontWeight, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolToVisibility}}"/>
                        </Grid>
                    </ListBoxItem>

                    <!-- Item 1: Personas -->
                    <ListBoxItem Style="{StaticResource SidebarNavItemStyle}" Tag="Personas" ToolTip="Personas"
                                 Padding="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource SidebarNavPadding}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource SidebarNavIconColumn}}"
                                  Grid.ColumnSpan="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource SidebarColumnSpan}}"
                                  Data="{StaticResource IconPersonas}"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                  Stretch="Uniform" Width="15" Height="15"
                                  Margin="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource SidebarIconMargin}}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Personas"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                       FontWeight="{Binding FontWeight, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolToVisibility}}"/>
                        </Grid>
                    </ListBoxItem>

                    <!-- Item 2: Préstamos -->
                    <ListBoxItem Style="{StaticResource SidebarNavItemStyle}" Tag="Préstamos" ToolTip="Préstamos"
                                 Padding="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource SidebarNavPadding}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource SidebarNavIconColumn}}"
                                  Grid.ColumnSpan="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource SidebarColumnSpan}}"
                                  Data="{StaticResource IconPrestamos}"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                  Stretch="Uniform" Width="15" Height="15"
                                  Margin="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource SidebarIconMargin}}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Préstamos"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                       FontWeight="{Binding FontWeight, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolToVisibility}}"/>
                        </Grid>
                    </ListBoxItem>

                    <!-- Item 3: Historial -->
                    <ListBoxItem Style="{StaticResource SidebarNavItemStyle}" Tag="Historial" ToolTip="Historial"
                                 Padding="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource SidebarNavPadding}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource SidebarNavIconColumn}}"
                                  Grid.ColumnSpan="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource SidebarColumnSpan}}"
                                  Data="{StaticResource IconHistorial}"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                  Stretch="Uniform" Width="15" Height="15"
                                  Margin="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource SidebarIconMargin}}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Historial"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                       FontWeight="{Binding FontWeight, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolToVisibility}}"/>
                        </Grid>
                    </ListBoxItem>

                    <!-- Item 4: Abonos -->
                    <ListBoxItem Style="{StaticResource SidebarNavItemStyle}" Tag="Abonos" ToolTip="Abonos"
                                 Padding="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource SidebarNavPadding}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource SidebarNavIconColumn}}"
                                  Grid.ColumnSpan="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource SidebarColumnSpan}}"
                                  Data="{StaticResource IconAbonos}"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                  Stretch="Uniform" Width="15" Height="15"
                                  Margin="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource SidebarIconMargin}}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Abonos"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                       FontWeight="{Binding FontWeight, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolToVisibility}}"/>
                        </Grid>
                    </ListBoxItem>

                    <!-- Item 5: Comprobantes -->
                    <ListBoxItem Style="{StaticResource SidebarNavItemStyle}" Tag="Comprobantes" ToolTip="Comprobantes"
                                 Padding="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource SidebarNavPadding}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource SidebarNavIconColumn}}"
                                  Grid.ColumnSpan="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource SidebarColumnSpan}}"
                                  Data="{StaticResource IconDocument}"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                  Stretch="Uniform" Width="15" Height="15"
                                  Margin="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource SidebarIconMargin}}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Comprobantes"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                       FontWeight="{Binding FontWeight, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolToVisibility}}"/>
                        </Grid>
                    </ListBoxItem>

                    <!-- Item 6: Asistente IA -->
                    <ListBoxItem Style="{StaticResource SidebarNavItemStyle}" Tag="Asistente IA" ToolTip="Asistente IA"
                                 Padding="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource SidebarNavPadding}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource SidebarNavIconColumn}}"
                                  Grid.ColumnSpan="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource SidebarColumnSpan}}"
                                  Data="{StaticResource IconIA}"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                  Stretch="Uniform" Width="15" Height="15"
                                  Margin="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource SidebarIconMargin}}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Asistente IA"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                       FontWeight="{Binding FontWeight, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolToVisibility}}"/>
                        </Grid>
                    </ListBoxItem>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ========================================== -->
        <!-- MAIN CONTENT AREA                          -->
        <!-- ========================================== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Top Bar -->
                <RowDefinition Height="Auto"/> <!-- Notification Banner -->
                <RowDefinition Height="*"/>    <!-- Main View Tabs -->
                <RowDefinition Height="Auto"/> <!-- Status Bar -->
            </Grid.RowDefinitions>

            <!-- 1. TOP BAR (Barra Superior Minimalista) -->
            <Border Grid.Row="0"
                    Background="{DynamicResource MonochromeSurfaceBrush}"
                    BorderBrush="{DynamicResource MonochromeBorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="26,16">
                <DockPanel>
                    <!-- Left: Breadcrumb / Section Name -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                        <TextBlock Text="Espacio de trabajo" Foreground="{DynamicResource MonochromeMutedBrush}" FontSize="{DynamicResource FsSm}" FontWeight="Medium"/>
                        <TextBlock Text=" / " Foreground="{DynamicResource MonochromeBorderStrongBrush}" FontSize="{DynamicResource FsSm}" Margin="6,0"/>
                        <TextBlock Text="{Binding SelectedItem.Tag, ElementName=Navigation, TargetNullValue=Dashboard, FallbackValue=Dashboard}"
                                   Foreground="{DynamicResource MonochromeTextBrush}"
                                   FontSize="{DynamicResource FsBase}" FontWeight="SemiBold"/>
                    </StackPanel>

                    <!-- Right: Section Selector ComboBox & Status Pill -->
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="Sección" VerticalAlignment="Center" Margin="0,0,8,0"
                                   FontSize="12" Foreground="{DynamicResource MonochromeSecondaryBrush}"/>
                        <ComboBox x:Name="HeaderModuleSelector"
                                  Width="170" Height="38" Margin="0"
                                  ItemsSource="{Binding Sections}"
                                  SelectedIndex="{Binding SelectedIndex, ElementName=MainTabs, Mode=TwoWay}"
                                  SelectionChanged="HeaderModuleSelector_SelectionChanged"
                                  AutomationProperties.Name="Seleccionar módulo"
                                  ToolTip="Cambiar de módulo rápidamente"/>
                        <Border Margin="12,0,0,0" Padding="8,4" Background="{DynamicResource MonochromeSurfaceAltBrush}" CornerRadius="12">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" Fill="{DynamicResource MonochromePrimaryBrush}" Margin="0,0,6,0"/>
                                <TextBlock Text="Local" FontSize="11" Foreground="{DynamicResource MonochromeSecondaryBrush}" FontWeight="Medium"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- 2. NOTIFICATION BANNER (Monocromático, elegante) -->
            <Border Grid.Row="1"
                    Margin="24,14,24,0"
                    Padding="16,13"
                    Background="{DynamicResource MonochromePrimaryBrush}"
                    BorderBrush="{DynamicResource MonochromeBorderStrongBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Effect="{StaticResource FloatingShadow}"
                    Visibility="{Binding BannerMessage, Converter={StaticResource StringToVisibility}}">
                <DockPanel>
                    <!-- Icono de estado: mismo color que el texto, sin introducir color. -->
                    <Path DockPanel.Dock="Left" Width="16" Height="16" Stretch="Uniform"
                          Fill="{DynamicResource MonochromeOnPrimaryBrush}"
                          Opacity="0.9" Margin="0,0,14,0" VerticalAlignment="Center">
                        <Path.Style>
                            <Style TargetType="Path">
                                <Setter Property="Data" Value="M11 11h2v7h-2v-7zm0-6h2v2h-2V5z"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding BannerIsError}" Value="True">
                                        <Setter Property="Data" Value="M11 5h2v9h-2V5zm0 11h2v2h-2v-2z"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>
                    <!-- Acción opcional (por ejemplo, descargar el recibo al saldar). -->
                    <Button DockPanel.Dock="Right"
                            Style="{StaticResource BannerActionButtonStyle}"
                            Content="{Binding BannerActionText}"
                            Command="{Binding DownloadReceiptCommand}"
                            Visibility="{Binding BannerActionText, Converter={StaticResource StringToVisibility}}"
                            AutomationProperties.Name="Descargar recibo"/>
                    <!-- Cierre compacto: hover sutil usando el color del tema. -->
                    <Button DockPanel.Dock="Right" Width="26" Height="26" Margin="12,0,0,0"
                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                            FocusVisualStyle="{DynamicResource AppFocusVisualStyle}"
                            Command="{Binding ClearBannerCommand}"
                            AutomationProperties.Name="Cerrar aviso"
                            ToolTip="Cerrar aviso">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid>
                                    <Border x:Name="CloseHover" CornerRadius="5"
                                            Background="{DynamicResource MonochromeOnPrimaryBrush}" Opacity="0"/>
                                    <Path Data="M19 6.41 17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"
                                          Fill="{DynamicResource MonochromeOnPrimaryBrush}"
                                          Width="12" Height="12" Stretch="Uniform"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="CloseHover" Property="Opacity" Value="0.16"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="CloseHover" Property="Opacity" Value="0.26"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.4"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <TextBlock Text="{Binding BannerMessage}"
                               Foreground="{DynamicResource MonochromeOnPrimaryBrush}"
                               FontSize="{DynamicResource FsBase}"
                               FontWeight="Medium"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"
                               AutomationProperties.LiveSetting="Polite"/>
                </DockPanel>
            </Border>

            <!-- 3. MAIN TAB CONTROL (Vistas de módulos) -->
            <TabControl Grid.Row="2" x:Name="MainTabs"
                        Margin="24,18,24,24"
                        BorderThickness="0"
                        Background="Transparent"
                        SelectedIndex="{Binding SelectedIndex, ElementName=Navigation}">

                <!-- ========================================== -->
                <!-- TAB 0: DASHBOARD                           -->
                <!-- ========================================== -->
                <TabItem Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,10,20">
                            <!-- Section Title -->
                            <DockPanel Margin="0,0,0,16">
                                <StackPanel DockPanel.Dock="Left">
                                    <TextBlock Text="Resumen Financiero" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource MonochromeTextBrush}"/>
                                    <TextBlock Text="Indicadores clave de saldo, abonos y actividad de préstamos" FontSize="13" Foreground="{DynamicResource MonochromeSecondaryBrush}" Margin="0,3,0,0"/>
                                </StackPanel>
                                <Button Content="Actualizar datos"
                                        Command="{Binding RefreshCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        HorizontalAlignment="Right"
                                        Padding="14,6" Height="34"
                                        AutomationProperties.Name="Actualizar métricas"/>
                            </DockPanel>

                            <!-- Primary KPI Grid -->
                            <UniformGrid Columns="4" Margin="0,0,0,6">
                                <Border Style="{StaticResource MetricCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="SALDO PENDIENTE" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource MonochromeSecondaryBrush}"/>
                                        <TextBlock Text="{Binding PendingTotal, StringFormat=C0}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource MonochromeTextBrush}" Margin="0,6,0,2"/>
                                        <TextBlock Text="Total por cobrar a clientes" FontSize="11" Foreground="{DynamicResource MonochromeMutedBrush}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource MetricCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="ABONOS DEL MES" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource MonochromeSecondaryBrush}"/>
                                        <TextBlock Text="{Binding PaymentsThisMonth, StringFormat=C0}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource MonochromeTextBrush}" Margin="0,6,0,2"/>
                                        <TextBlock Text="Recaudación en el mes vigente" FontSize="11" Foreground="{DynamicResource MonochromeMutedBrush}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource MetricCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="PRÉSTAMOS ACTIVOS" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource MonochromeSecondaryBrush}"/>
                                        <TextBlock Text="{Binding ActiveLoans}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource MonochromeTextBrush}" Margin="0,6,0,2"/>
                                        <TextBlock Text="Cuentas con saldo mayor a cero" FontSize="11" Foreground="{DynamicResource MonochromeMutedBrush}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource MetricCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="ABONOS REGISTRADOS" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource MonochromeSecondaryBrush}"/>
                                        <TextBlock Text="{Binding PaymentCount}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource MonochromeTextBrush}" Margin="0,6,0,2"/>
                                        <TextBlock Text="Transacciones históricas" FontSize="11" Foreground="{DynamicResource MonochromeMutedBrush}"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <!-- Indicador financiero secundario -->
                            <Border Style="{StaticResource MetricCardStyle}"
                                    HorizontalAlignment="Left" MinWidth="240" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="MEDIANA DE PRÉSTAMOS" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource MonochromeSecondaryBrush}"/>
                                    <TextBlock Text="{Binding MedianLoanAmount, StringFormat=C0}" FontSize="23" FontWeight="SemiBold" Foreground="{DynamicResource MonochromeTextBrush}" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Visual Analytics (Bar Chart & Line Chart) -->
                            <Grid Height="280">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Column 0: Bar Chart (Abonos por mes) -->
                                <Border Grid.Column="0" Style="{StaticResource PanelCardStyle}" Margin="0,0,8,0">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Top" Text="Abonos por mes" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource MonochromeTextBrush}" Margin="0,0,0,12"/>
                                        <ItemsControl ItemsSource="{Binding MonthlyAnalytics}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Rows="1"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="4,0">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="110"/>
                                                        </Grid.RowDefinitions>
                                                        <Border Grid.Row="1"
                                                                Width="20"
                                                                Height="{Binding PaymentBarHeight}"
                                                                Background="{DynamicResource MonochromePrimaryBrush}"
                                                                CornerRadius="4,4,0,0"
                                                                VerticalAlignment="Bottom">
                                                            <Border.ToolTip>
                                                                <ToolTip Content="{Binding Payments, StringFormat=C0}"/>
                                                            </Border.ToolTip>
                                                        </Border>
                                                        <Border Grid.Row="0"
                                                                Background="{DynamicResource MonochromeSurfaceAltBrush}"
                                                                BorderBrush="{DynamicResource MonochromeBorderBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="6"
                                                                Padding="5,2"
                                                                Margin="0,0,0,6"
                                                                HorizontalAlignment="Center">
                                                            <TextBlock Text="{Binding Label}"
                                                                       HorizontalAlignment="Center"
                                                                       FontSize="{DynamicResource FsXs}"
                                                                       Foreground="{DynamicResource MonochromeTextBrush}"/>
                                                        </Border>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </DockPanel>
                                </Border>

                                <!-- Column 1: Line Chart (Tendencia de abonos) -->
                                <Border Grid.Column="1" Style="{StaticResource PanelCardStyle}" Margin="8,0,0,0">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Top" Text="Tendencia de pagos" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource MonochromeTextBrush}" Margin="0,0,0,12"/>
                                        <Canvas x:Name="MonthlyLineChart"
                                                SizeChanged="MonthlyLineChart_SizeChanged"
                                                Loaded="MonthlyLineChart_Loaded"/>
                                    </DockPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ========================================== -->
                <!-- TAB 1: PERSONAS (Directorio de Clientes)   -->
                <!-- ========================================== -->
                <TabItem Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Form Card -->
                            <RowDefinition Height="*"/>    <!-- DataGrid Card -->
                            <RowDefinition Height="Auto"/> <!-- Actions Bar -->
                        </Grid.RowDefinitions>

                        <!-- Registration Card -->
                        <Border Grid.Row="0" Style="{StaticResource PanelCardStyle}" Margin="0,0,0,16" Padding="18,14">
                            <StackPanel>
                                <TextBlock Text="Registrar nueva persona" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource MonochromeTextBrush}"/>
                                <TextBlock Text="Complete los datos y agregue un contacto a la cartera" FontSize="{DynamicResource FsSm}" Foreground="{DynamicResource MonochromeMutedBrush}" Margin="0,3,0,16"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                        <TextBlock Text="Nombre completo" FontSize="11.5" Foreground="{DynamicResource MonochromeSecondaryBrush}"/>
                                        <TextBox Text="{Binding PersonName, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True, NotifyOnValidationError=True}"
                                                 Margin="0,4,0,0"
                                                 AutomationProperties.Name="Nombre de la persona"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                        <TextBlock Text="Teléfono / Contacto" FontSize="11.5" Foreground="{DynamicResource MonochromeSecondaryBrush}"/>
                                        <TextBox Text="{Binding PersonPhone, UpdateSourceTrigger=PropertyChanged}"
                                                 Margin="0,4,0,0"
                                                 AutomationProperties.Name="Teléfono"/>
                                    </StackPanel>
                                    <Button Grid.Column="2"
                                            Content="Registrar persona"
                                            Command="{Binding AddPersonCommand}"
                                            VerticalAlignment="Bottom"
                                            Height="36" Padding="18,0"
                                            AutomationProperties.Name="Registrar persona"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Table Card -->
                        <Border Grid.Row="1" Style="{StaticResource PanelCardStyle}" Padding="0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Padding="12,10,12,8"
                                        BorderBrush="{DynamicResource MonochromeBorderLightBrush}"
                                        BorderThickness="0,0,0,1">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Left" Text="Buscar" FontSize="11.5"
                                                   Foreground="{DynamicResource MonochromeSecondaryBrush}"
                                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <Button DockPanel.Dock="Right" Content="Limpiar"
                                                Command="{Binding ClearPersonSearchCommand}"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Width="80" Height="32" Margin="8,0,0,0"
                                                AutomationProperties.Name="Limpiar búsqueda de personas"/>
                                        <TextBlock DockPanel.Dock="Right"
                                                   Text="{Binding PersonResultText}"
                                                   FontSize="11" Foreground="{DynamicResource MonochromeMutedBrush}"
                                                   VerticalAlignment="Center" Margin="8,0,0,0"/>
                                        <TextBox Height="34" Padding="10,6"
                                                 Text="{Binding PersonSearch, UpdateSourceTrigger=PropertyChanged}"
                                                 AutomationProperties.Name="Buscar personas por nombre o teléfono"/>
                                    </DockPanel>
                                </Border>

                                <Grid Grid.Row="1">
                                    <DataGrid x:Name="PeopleGrid"
                                              ItemsSource="{Binding FilteredPeople}"
                                              SelectedItem="{Binding SelectedPerson}"
                                              Sorting="DataGrid_Sorting"
                                              PreviewKeyDown="PeopleGrid_PreviewKeyDown"
                                              BorderThickness="0"
                                              ToolTip="Seleccione una fila y pulse Supr para eliminarla"
                                              AutomationProperties.Name="Lista de personas">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Nombre" Binding="{Binding Name}" Width="*"/>
                                            <DataGridTextColumn Header="Teléfono" Binding="{Binding Phone}" Width="200"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <TextBlock Text="No hay personas para mostrar. Ajuste la búsqueda o registre una persona."
                                               Visibility="{Binding FilteredPeople.Count, Converter={StaticResource CountToVisibility}}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"
                                               Foreground="{DynamicResource MonochromeSecondaryBrush}" IsHitTestVisible="False"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Bottom Action Buttons -->
                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                            <Button Content="Editar persona" Click="EditPersonClick"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    ToolTip="Editar la persona seleccionada"
                                    AutomationProperties.Name="Editar persona"/>
                            <Button Content="Eliminar persona" Margin="8,0,0,0" Click="DeletePersonClick"
                                    Style="{StaticResource DangerOutlineButtonStyle}"
                                    ToolTip="Eliminar selección (Supr)"
                                    AutomationProperties.Name="Eliminar persona"/>
                        </StackPanel>
                    </Grid>
                </TabItem>

                <!-- ========================================== -->
                <!-- TAB 2: PRÉSTAMOS (Ventas Fiadas / Créditos)-->
                <!-- ========================================== -->
                <TabItem Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="320"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left Form Panel -->
                        <Border Grid.Column="0" Style="{StaticResource PanelCardStyle}" Margin="0,0,16,0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="Nuevo préstamo" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource MonochromeTextBrush}"/>
                                    <TextBlock Text="Asigne un crédito o fiado a un cliente" FontSize="{DynamicResource FsSm}" Foreground="{DynamicResource MonochromeMutedBrush}" Margin="0,3,0,18"/>

                                    <TextBlock Text="Cliente / Persona" FontSize="11.5" Foreground="{DynamicResource MonochromeSecondaryBrush}"/>
                                    <local:PersonPicker ItemsSource="{Binding People}"
                                                        SelectedItem="{Binding SelectedPerson}"
                                                        PlaceholderText="Buscar cliente por nombre o teléfono"
                                                        Margin="0,4,0,4"
                                                        AutomationProperties.Name="Persona del préstamo"/>
                                    <Border Margin="0,0,0,12" Padding="9,7"
                                            Background="{DynamicResource MonochromeSurfaceAltBrush}"
                                            BorderBrush="{DynamicResource MonochromeBorderBrush}"
                                            BorderThickness="1" CornerRadius="8"
                                            AutomationProperties.Name="Cliente seleccionado para el préstamo">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource IconCheck}" Width="14" Height="14"
                                                  Fill="{DynamicResource MonochromePrimaryBrush}"
                                                  Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0">
                                                <Path.Style>
                                                    <Style TargetType="Path">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedPerson}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Path.Style>
                                            </Path>
                                            <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource FsSm}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource MonochromeTextBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedPerson}" Value="{x:Null}">
                                                                <Setter Property="Foreground" Value="{DynamicResource MonochromeMutedBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                                <Run Text="Cliente: " Foreground="{DynamicResource MonochromeSecondaryBrush}"/>
                                                <Run Text="{Binding SelectedPerson.Name, Mode=OneWay, TargetNullValue='ninguno — busque y elija un cliente'}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Text="Monto a prestar" FontSize="11.5" Foreground="{DynamicResource MonochromeSecondaryBrush}"/>
                                    <TextBox Text="{Binding LoanAmount, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True, NotifyOnValidationError=True}"
                                             AutomationProperties.Name="Monto del préstamo"/>

                                    <TextBlock Text="Fecha del crédito" FontSize="11.5" Foreground="{DynamicResource MonochromeSecondaryBrush}"/>
                                    <DatePicker SelectedDate="{Binding LoanDate}" Margin="0,4,0,12"
                                                DisplayDateEnd="{Binding LoanMaxDate}"
                                                AutomationProperties.Name="Fecha del préstamo"/>

                                    <TextBlock Text="Notas u observaciones" FontSize="11.5" Foreground="{DynamicResource MonochromeSecondaryBrush}"/>
                                    <TextBox Text="{Binding LoanNotes, UpdateSourceTrigger=PropertyChanged}"
                                             AcceptsReturn="True" Height="70" VerticalContentAlignment="Top"
                                             AutomationProperties.Name="Notas del préstamo"/>

                                    <Button Content="Registrar préstamo"
                                            Command="{Binding AddLoanCommand}"
                                            Height="38" Margin="0,6,0,0"
                                            AutomationProperties.Name="Registrar préstamo"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <!-- Right Table & Actions Panel -->
                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Style="{StaticResource PanelCardStyle}" Padding="0">
                                <Grid>
                                    <DataGrid x:Name="LoansGrid"
                                              ItemsSource="{Binding Loans}"
                                              SelectedItem="{Binding SelectedLoan}"
                                              Sorting="DataGrid_Sorting"
                                              PreviewKeyDown="LoansGrid_PreviewKeyDown"
                                              BorderThickness="0"
                                              ToolTip="Seleccione una fila y pulse Supr para eliminarla"
                                              AutomationProperties.Name="Lista de préstamos">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Persona" Binding="{Binding Loan.PersonName}" Width="*"/>
                                            <DataGridTextColumn Header="Monto" Binding="{Binding Loan.Amount, StringFormat=C0}" Width="120"/>
                                            <DataGridTextColumn Header="Abonado" Binding="{Binding Paid, StringFormat=C0}" Width="120"/>
                                            <DataGridTextColumn Header="Saldo" Binding="{Binding Balance, StringFormat=C0, Mode=OneWay}" Width="120" IsReadOnly="True"/>
                                            <DataGridTextColumn Header="Estado" Binding="{Binding Balance, Converter={StaticResource BalanceStatus}, Mode=OneWay}" Width="100" IsReadOnly="True"/>
                                            <DataGridTextColumn Header="Fecha" Binding="{Binding Loan.LoanDate, StringFormat=dd/MM/yyyy}" Width="110"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <TextBlock Text="No hay préstamos registrados. Seleccione una persona a la izquierda para iniciar."
                                               Visibility="{Binding Loans.Count, Converter={StaticResource CountToVisibility}}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"
                                               Foreground="{DynamicResource MonochromeSecondaryBrush}" IsHitTestVisible="False"/>
                                </Grid>
                            </Border>

                            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                                <Button Content="Editar préstamo" Click="EditLoanClick"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        ToolTip="Editar el préstamo seleccionado"
                                        AutomationProperties.Name="Editar préstamo"/>
                                <Button Content="Eliminar préstamo" Margin="8,0,0,0" Click="DeleteLoanClick"
                                        Style="{StaticResource DangerOutlineButtonStyle}"
                                        ToolTip="Eliminar selección (Supr)"
                                        AutomationProperties.Name="Eliminar préstamo"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- ========================================== -->
                <!-- TAB 3: HISTORIAL (Consultas y Auditoría)   -->
                <!-- ========================================== -->
                <TabItem Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Selector de cliente -->
                            <RowDefinition Height="Auto"/> <!-- Resumen del cliente -->
                            <RowDefinition Height="*"/>    <!-- Préstamos del cliente -->
                            <RowDefinition Height="230"/>  <!-- Abonos del cliente -->
                        </Grid.RowDefinitions>

                        <!-- Selector de cliente -->
                        <Border Grid.Row="0" Style="{StaticResource PanelCardStyle}" Margin="0,0,0,14" Padding="18,14">
                            <StackPanel>
                                <TextBlock Text="Consultar historial" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource MonochromeTextBrush}"/>
                                <TextBlock Text="Elija un cliente para ver sus préstamos y abonos" FontSize="{DynamicResource FsSm}" Foreground="{DynamicResource MonochromeMutedBrush}" Margin="0,3,0,10"/>
                                <local:PersonPicker ItemsSource="{Binding HistoryClients}"
                                                    SelectedItem="{Binding HistorySelectedPerson}"
                                                    PlaceholderText="Buscar cliente para consultar su historial"
                                                    AutomationProperties.Name="Cliente seleccionado en historial"/>
                                <Border Margin="0,8,0,0" Padding="9,7"
                                        Background="{DynamicResource MonochromeSurfaceAltBrush}"
                                        BorderBrush="{DynamicResource MonochromeBorderBrush}"
                                        BorderThickness="1" CornerRadius="8"
                                        AutomationProperties.Name="Cliente elegido en el historial">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconCheck}" Width="14" Height="14"
                                              Fill="{DynamicResource MonochromePrimaryBrush}"
                                              Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0">
                                            <Path.Style>
                                                <Style TargetType="Path">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HistorySelectedPerson}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                        </Path>
                                        <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource FsSm}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource MonochromeTextBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HistorySelectedPerson}" Value="{x:Null}">
                                                            <Setter Property="Foreground" Value="{DynamicResource MonochromeMutedBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                            <Run Text="Cliente: " Foreground="{DynamicResource MonochromeSecondaryBrush}"/>
                                            <Run Text="{Binding HistorySelectedPerson.Name, Mode=OneWay, TargetNullValue='ninguno — busque y elija un cliente'}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Resumen del cliente seleccionado -->
                        <Border Grid.Row="1" Style="{StaticResource PanelCardStyle}" Margin="0,0,0,14" Padding="16,12">
                            <Grid>
                                <Grid Visibility="{Binding HasHistoryClient, Converter={StaticResource BoolToVisibility}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="CLIENTE" FontSize="10.5" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource MonochromeMutedBrush}"/>
                                        <TextBlock Text="{Binding HistorySelectedPerson.Name}" FontSize="15" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource MonochromeTextBrush}" Margin="0,3,0,0"/>
                                        <TextBlock Text="{Binding HistorySelectedPerson.Phone}" FontSize="11.5"
                                                   Foreground="{DynamicResource MonochromeSecondaryBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="PRÉSTAMOS" FontSize="10.5" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource MonochromeMutedBrush}"/>
                                        <TextBlock Text="{Binding HistorySummary.LoanCount}" FontSize="15" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource MonochromeTextBrush}" Margin="0,3,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="PRESTADO" FontSize="10.5" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource MonochromeMutedBrush}"/>
                                        <TextBlock Text="{Binding HistorySummary.LoanTotal, StringFormat=C0}" FontSize="15" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource MonochromeTextBrush}" Margin="0,3,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="3">
                                        <TextBlock Text="PAGADO" FontSize="10.5" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource MonochromeMutedBrush}"/>
                                        <TextBlock Text="{Binding HistorySummary.PaidTotal, StringFormat=C0}" FontSize="15" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource MonochromeTextBrush}" Margin="0,3,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="SALDO" FontSize="10.5" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource MonochromeMutedBrush}"/>
                                        <TextBlock Text="{Binding HistorySummary.Balance, StringFormat=C0}" FontSize="15" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource MonochromeTextBrush}" Margin="0,3,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="5">
                                        <TextBlock Text="ESTADO" FontSize="10.5" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource MonochromeMutedBrush}"/>
                                        <TextBlock Text="{Binding HistorySummary.Balance, Converter={StaticResource BalanceStatus}}"
                                                   FontSize="15" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource MonochromeTextBrush}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Seleccione un cliente para ver su historial."
                                           Visibility="{Binding HasHistoryClient, Converter={StaticResource InverseBoolToVisibility}}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource MonochromeSecondaryBrush}" FontSize="12.5"/>
                            </Grid>
                        </Border>

                        <!-- Préstamos del cliente -->
                        <Border Grid.Row="2" Style="{StaticResource PanelCardStyle}" Padding="0" Margin="0,0,0,12">
                            <Grid>
                                <DataGrid x:Name="HistoryLoansGrid"
                                          ItemsSource="{Binding HistoryLoans}"
                                          Sorting="DataGrid_Sorting"
                                          BorderThickness="0"
                                          AutomationProperties.Name="Préstamos del cliente seleccionado">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Fecha" Binding="{Binding Loan.LoanDate, StringFormat=dd/MM/yyyy}" Width="120"/>
                                        <DataGridTextColumn Header="Monto" Binding="{Binding Loan.Amount, StringFormat=C0}" Width="130"/>
                                        <DataGridTextColumn Header="Abonado" Binding="{Binding Paid, StringFormat=C0}" Width="130"/>
                                        <DataGridTextColumn Header="Saldo" Binding="{Binding Balance, StringFormat=C0, Mode=OneWay}" Width="130" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="Estado" Binding="{Binding Balance, Converter={StaticResource BalanceStatus}, Mode=OneWay}" Width="100" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="Notas" Binding="{Binding Loan.Notes}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock Text="El cliente seleccionado aún no tiene préstamos registrados."
                                           Visibility="{Binding HistoryLoans.Count, Converter={StaticResource CountToVisibility}}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"
                                           Foreground="{DynamicResource MonochromeSecondaryBrush}" IsHitTestVisible="False"/>
                            </Grid>
                        </Border>

                        <!-- Abonos del cliente -->
                        <Border Grid.Row="3" Style="{StaticResource PanelCardStyle}" Padding="0">
                            <Grid>
                                <DataGrid x:Name="HistoryPaymentsGrid"
                                          ItemsSource="{Binding HistoryPayments}"
                                          Sorting="DataGrid_Sorting"
                                          BorderThickness="0"
                                          AutomationProperties.Name="Abonos del cliente seleccionado">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Préstamo" Binding="{Binding LoanLabel}" Width="170"/>
                                        <DataGridTextColumn Header="Fecha" Binding="{Binding PaymentDate, StringFormat=dd/MM/yyyy}" Width="120"/>
                                        <DataGridTextColumn Header="Monto" Binding="{Binding Amount, StringFormat=C0}" Width="130"/>
                                        <DataGridTextColumn Header="Notas" Binding="{Binding Notes}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock Text="El cliente seleccionado aún no tiene abonos registrados."
                                           Visibility="{Binding HistoryPayments.Count, Converter={StaticResource CountToVisibility}}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"
                                           Foreground="{DynamicResource MonochromeSecondaryBrush}" IsHitTestVisible="False"/>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- ========================================== -->
                <!-- TAB 4: ABONOS (Recaudos y Pagos)          -->
                <!-- ========================================== -->
                <TabItem Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="320"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left Form Panel -->
                        <Border Grid.Column="0" Style="{StaticResource PanelCardStyle}" Margin="0,0,16,0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="Registrar abono" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource MonochromeTextBrush}"/>
                                    <TextBlock Text="Registre un pago parcial o total a un crédito" FontSize="{DynamicResource FsSm}" Foreground="{DynamicResource MonochromeMutedBrush}" Margin="0,3,0,18"/>

                                    <TextBlock Text="Préstamo pendiente" FontSize="11.5" Foreground="{DynamicResource MonochromeSecondaryBrush}"/>
                                    <ComboBox ItemsSource="{Binding PendingLoans}"
                                              SelectedItem="{Binding SelectedLoan}" Margin="0,4,0,4"
                                              AutomationProperties.Name="Préstamo pendiente para abonar">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock>
                                                    <Run Text="{Binding Loan.PersonName}" FontWeight="SemiBold"/>
                                                    <Run Text=" (Saldo: " Foreground="{DynamicResource MonochromeSecondaryBrush}"/>
                                                    <Run Text="{Binding Balance, StringFormat=C0, Mode=OneWay}" Foreground="{DynamicResource MonochromeSecondaryBrush}"/>
                                                    <Run Text=")" Foreground="{DynamicResource MonochromeSecondaryBrush}"/>
                                                </TextBlock>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <Border Margin="0,0,0,12" Padding="9,7"
                                            Background="{DynamicResource MonochromeSurfaceAltBrush}"
                                            BorderBrush="{DynamicResource MonochromeBorderBrush}"
                                            BorderThickness="1" CornerRadius="8"
                                            AutomationProperties.Name="Cliente del préstamo seleccionado">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource IconCheck}" Width="14" Height="14"
                                                  Fill="{DynamicResource MonochromePrimaryBrush}"
                                                  Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0">
                                                <Path.Style>
                                                    <Style TargetType="Path">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedLoan}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Path.Style>
                                            </Path>
                                            <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource FsSm}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource MonochromeTextBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedLoan}" Value="{x:Null}">
                                                                <Setter Property="Foreground" Value="{DynamicResource MonochromeMutedBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                                <Run Text="Cliente: " Foreground="{DynamicResource MonochromeSecondaryBrush}"/>
                                                <Run Text="{Binding SelectedLoan.Loan.PersonName, Mode=OneWay, TargetNullValue='ninguno — elija un préstamo'}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Text="Monto abonado" FontSize="11.5" Foreground="{DynamicResource MonochromeSecondaryBrush}"/>
                                    <TextBox Text="{Binding PaymentAmount, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True, NotifyOnValidationError=True}"
                                             AutomationProperties.Name="Monto del abono"/>

                                    <TextBlock Text="Fecha del pago" FontSize="11.5" Foreground="{DynamicResource MonochromeSecondaryBrush}"/>
                                    <DatePicker SelectedDate="{Binding PaymentDate}" Margin="0,4,0,12"
                                                DisplayDateStart="{Binding PaymentMinDate}"
                                                DisplayDateEnd="{Binding PaymentMaxDate}"
                                                AutomationProperties.Name="Fecha del abono"/>

                                    <TextBlock Text="Notas u observaciones" FontSize="11.5" Foreground="{DynamicResource MonochromeSecondaryBrush}"/>
                                    <TextBox Text="{Binding PaymentNotes, UpdateSourceTrigger=PropertyChanged}"
                                             AcceptsReturn="True" Height="70" VerticalContentAlignment="Top"
                                             AutomationProperties.Name="Notas del abono"/>

                                    <Button Content="Registrar abono"
                                            Command="{Binding AddPaymentCommand}"
                                            Height="38" Margin="0,6,0,0"
                                            AutomationProperties.Name="Registrar abono"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <!-- Right Table & Actions Panel -->
                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Style="{StaticResource PanelCardStyle}" Padding="0">
                                <Grid>
                                    <DataGrid x:Name="PaymentsGrid"
                                              ItemsSource="{Binding Payments}"
                                              SelectedItem="{Binding SelectedPayment}"
                                              Sorting="DataGrid_Sorting"
                                              PreviewKeyDown="PaymentsGrid_PreviewKeyDown"
                                              BorderThickness="0"
                                              ToolTip="Seleccione una fila y pulse Supr para eliminarla"
                                              AutomationProperties.Name="Lista de abonos">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Préstamo" Binding="{Binding LoanLabel}" Width="180"/>
                                            <DataGridTextColumn Header="Monto" Binding="{Binding Amount, StringFormat=C0}" Width="130"/>
                                            <DataGridTextColumn Header="Fecha" Binding="{Binding PaymentDate, StringFormat=dd/MM/yyyy}" Width="120"/>
                                            <DataGridTextColumn Header="Notas" Binding="{Binding Notes}" Width="*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <TextBlock Text="No hay abonos registrados todavía. Seleccione un préstamo y registre el primero."
                                               Visibility="{Binding Payments.Count, Converter={StaticResource CountToVisibility}}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"
                                               Foreground="{DynamicResource MonochromeSecondaryBrush}" IsHitTestVisible="False"/>
                                </Grid>
                            </Border>

                            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                                <Button Content="Editar abono" Click="EditPaymentClick"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        ToolTip="Editar el abono seleccionado"
                                        AutomationProperties.Name="Editar abono"/>
                                <Button Content="Eliminar abono" Margin="8,0,0,0" Click="DeletePaymentClick"
                                        Style="{StaticResource DangerOutlineButtonStyle}"
                                        ToolTip="Eliminar selección (Supr)"
                                        AutomationProperties.Name="Eliminar abono"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- ======================================================= -->
                <!-- TAB 5: COMPROBANTES (Recibos de préstamos saldados)     -->
                <!-- ======================================================= -->
                <TabItem Visibility="Collapsed">
                    <Grid Margin="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource PanelCardStyle}" Margin="0,0,0,14" Padding="20,16">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="32" Height="32" CornerRadius="8"
                                            Background="{DynamicResource MonochromeSurfaceAltBrush}" Margin="0,0,10,0">
                                        <Path Data="{StaticResource IconDocument}"
                                              Fill="{DynamicResource MonochromePrimaryBrush}"
                                              Stretch="Uniform" Width="16" Height="16"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel>
                                        <TextBlock Text="Comprobantes" FontSize="16" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource MonochromeTextBrush}"/>
                                        <TextBlock Text="Descargue el recibo de un préstamo ya saldado"
                                                   FontSize="{DynamicResource FsSm}"
                                                   Foreground="{DynamicResource MonochromeMutedBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Margin="0,18,0,0"
                                            Visibility="{Binding SettledLoans.Count, Converter={StaticResource InverseCountToVisibility}}">
                                    <TextBlock Text="Préstamo saldado" FontSize="11.5"
                                               Foreground="{DynamicResource MonochromeSecondaryBrush}"/>
                                    <ComboBox ItemsSource="{Binding SettledLoans}"
                                              SelectedItem="{Binding SelectedSettledLoan}"
                                              Margin="0,4,0,12"
                                              AutomationProperties.Name="Préstamo saldado para descargar recibo">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock>
                                                    <Run Text="{Binding Loan.PersonName}" FontWeight="SemiBold"/>
                                                    <Run Text=" · " Foreground="{DynamicResource MonochromeSecondaryBrush}"/>
                                                    <Run Text="{Binding Loan.Id, StringFormat=000000}" Foreground="{DynamicResource MonochromeSecondaryBrush}"/>
                                                </TextBlock>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <Button Content="Descargar recibo"
                                            Command="{Binding DownloadReceiptCommand}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Height="36" HorizontalAlignment="Left"
                                            AutomationProperties.Name="Descargar recibo del préstamo saldado"
                                            ToolTip="Descargar el comprobante del préstamo saldado elegido"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Style="{StaticResource PanelCardStyle}" Padding="24"
                                Visibility="{Binding SettledLoans.Count, Converter={StaticResource CountToVisibility}}">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Path Data="{StaticResource IconDocument}"
                                      Fill="{DynamicResource MonochromeMutedBrush}"
                                      Stretch="Uniform" Width="38" Height="38" Margin="0,0,0,14"/>
                                <TextBlock Text="Aún no hay préstamos saldados" FontSize="14"
                                           Foreground="{DynamicResource MonochromeTextBrush}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Cuando un crédito se pague por completo, su recibo aparecerá aquí."
                                           FontSize="{DynamicResource FsSm}"
                                           Foreground="{DynamicResource MonochromeMutedBrush}"
                                           Margin="0,6,0,0" TextWrapping="Wrap"
                                           HorizontalAlignment="Center" MaxWidth="360"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- ======================================================= -->
                <!-- TAB 6: ASISTENTE IA (Diseño Especial Tipo ChatGPT/Linear) -->
                <!-- ======================================================= -->
                <TabItem Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- AI Header Bar -->
                            <RowDefinition Height="*"/>    <!-- Conversational Feed -->
                            <RowDefinition Height="Auto"/> <!-- Modern Input Area -->
                        </Grid.RowDefinitions>

                        <!-- 1. AI Header Bar -->
                        <Border Grid.Row="0" Style="{StaticResource PanelCardStyle}" Margin="0,0,0,12" Padding="16,12">
                            <DockPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                                    <Border Width="34" Height="34" CornerRadius="8" Background="{DynamicResource MonochromePrimaryBrush}" Margin="0,0,12,0">
                                        <Path Data="{StaticResource IconIA}" Fill="{DynamicResource MonochromeOnPrimaryBrush}" Stretch="Uniform" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Asistente IA" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource MonochromeTextBrush}"/>
                                            <Border Background="{DynamicResource MonochromeSurfaceAltBrush}" CornerRadius="10" Padding="8,2" Margin="10,0,0,0">
                                                <TextBlock Text="Motor Local" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource MonochromeSecondaryBrush}"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="Consulta deudas, saldos y resúmenes de clientes mediante lenguaje natural"
                                                   FontSize="11.5" Foreground="{DynamicResource MonochromeSecondaryBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button Command="{Binding GenerateSummaryCommand}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Height="34" Padding="12,0" Margin="0,0,8,0"
                                            ToolTip="Generar informe resumido con IA"
                                            AutomationProperties.Name="Generar resumen">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource IconDocument}" Fill="{DynamicResource MonochromeTextBrush}" Stretch="Uniform" Width="12" Height="12" Margin="0,0,6,0"/>
                                            <TextBlock Text="Generar resumen" FontSize="12"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding ClearChatCommand}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Height="34" Padding="12,0"
                                            ToolTip="Borrar historial de la conversación actual"
                                            AutomationProperties.Name="Limpiar conversación">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource IconDelete}" Fill="{DynamicResource MonochromeSecondaryBrush}" Stretch="Uniform" Width="12" Height="12" Margin="0,0,6,0"/>
                                            <TextBlock Text="Limpiar chat" FontSize="12"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- 2. Conversational Message Feed -->
                        <Border Grid.Row="1" Style="{StaticResource PanelCardStyle}" Padding="16,14">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding ChatMessages}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid HorizontalAlignment="{Binding Role, Converter={StaticResource RoleToAlignment}}"
                                                  Margin="{Binding Role, Converter={StaticResource RoleToMargin}}">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <!-- Sender label -->
                                                <TextBlock Grid.Row="0"
                                                           Text="{Binding Role, Converter={StaticResource RoleToSenderName}}"
                                                           FontSize="10.5" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource MonochromeSecondaryBrush}"
                                                           HorizontalAlignment="{Binding Role, Converter={StaticResource RoleToAlignment}}"
                                                           Margin="4,0,4,3"/>

                                                <!-- Message Bubble -->
                                                <Border Grid.Row="1"
                                                        Background="{Binding Role, Converter={StaticResource RoleToBubbleBg}}"
                                                        BorderBrush="{Binding Role, Converter={StaticResource RoleToBubbleBorder}}"
                                                        BorderThickness="1"
                                                        CornerRadius="{Binding Role, Converter={StaticResource RoleToCornerRadius}}"
                                                        Padding="14,10"
                                                        MaxWidth="680"
                                                        SnapsToDevicePixels="True">
                                                    <TextBlock Text="{Binding Text}"
                                                               Foreground="{Binding Role, Converter={StaticResource RoleToBubbleFg}}"
                                                               FontSize="13"
                                                               TextWrapping="Wrap"
                                                               LineHeight="19"/>
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>

                        <!-- 3. Modern Input Area (Floating Input Box) -->
                        <Border Grid.Row="2" Style="{StaticResource PanelCardStyle}" Margin="0,12,0,0" Padding="14,10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Text Input -->
                                <TextBox x:Name="ChatInputBox" Grid.Row="0"
                                         Text="{Binding ChatInput, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="Pregunta al asistente (Enter para enviar)"
                                         KeyDown="ChatInputBox_KeyDown"
                                         AcceptsReturn="True"
                                         MinHeight="44" MaxHeight="100"
                                         Margin="0,0,0,8"
                                         Padding="4,2"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         VerticalContentAlignment="Top"
                                         FontSize="13.5"/>

                                <!-- Bottom Control Bar (Spinner & Send Button) -->
                                <DockPanel Grid.Row="1">
                                    <!-- Processing / Loading Indicator -->
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left"
                                                Visibility="{Binding ChatIsLoading, Converter={StaticResource BoolToVisibility}}">
                                        <Control Template="{StaticResource SpinnerTemplate}" Width="16" Height="16" Margin="0,0,8,0"/>
                                        <TextBlock Text="Analizando datos financieros..." FontSize="12" Foreground="{DynamicResource MonochromeSecondaryBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- Send Button -->
                                    <Button DockPanel.Dock="Right" HorizontalAlignment="Right"
                                            Command="{Binding SendChatCommand}"
                                            IsEnabled="{Binding ChatIsLoading, Converter={StaticResource InverseBool}}"
                                            Height="34" Padding="18,0"
                                            AutomationProperties.Name="Consultar al asistente">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Enviar consulta" FontSize="12" FontWeight="SemiBold"/>
                                            <Path Data="{StaticResource IconSend}" Fill="{DynamicResource MonochromeOnPrimaryBrush}" Stretch="Uniform" Width="11" Height="11" Margin="8,0,0,0"/>
                                        </StackPanel>
                                    </Button>
                                </DockPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>

            <!-- 4. BOTTOM STATUS BAR -->
            <Border Grid.Row="3"
                    Background="{DynamicResource MonochromeSurfaceBrush}"
                    BorderBrush="{DynamicResource MonochromeBorderBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="24,7">
                <DockPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                        <Ellipse Width="6" Height="6" Fill="{DynamicResource MonochromePrimaryBrush}" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding StatusMessage}"
                                   Foreground="{DynamicResource MonochromeSecondaryBrush}"
                                   FontSize="11.5"
                                   AutomationProperties.LiveSetting="Polite"/>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right"
                               Text="Fiadex • Sistema Monocromático de Gestión"
                               Foreground="{DynamicResource MonochromeMutedBrush}"
                               FontSize="11"/>
                </DockPanel>
            </Border>
        </Grid>

        <!-- SUBMENÚ DE ACCESIBILIDAD (se abre desde la barra lateral) -->
        <Popup x:Name="AccessibilityPopup"
               Placement="Right"
               PlacementTarget="{Binding ElementName=AccessibilityButton}"
               StaysOpen="False"
               PopupAnimation="None"
               Opened="AccessibilityPopup_Opened"
               Closed="AccessibilityPopup_Closed">
            <Border x:Name="AccessibilityPopupBorder"
                    Background="{DynamicResource MonochromeSurfaceBrush}"
                    BorderBrush="{DynamicResource MonochromeBorderStrongBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="18"
                    Width="290"
                    MaxHeight="520"
                    PreviewKeyDown="AccessibilityPopup_PreviewKeyDown">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Accesibilidad"
                               FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource MonochromeTextBrush}"
                               Margin="0,0,0,4"/>
                    <TextBlock DockPanel.Dock="Top" Text="Los cambios se guardan automáticamente"
                               FontSize="{DynamicResource FsXs}"
                               Foreground="{DynamicResource MonochromeMutedBrush}"
                               TextWrapping="Wrap" Margin="0,0,0,14"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <TextBlock Text="Tamaño de texto" FontWeight="SemiBold"
                                       FontSize="{DynamicResource FsXs}"
                                       Foreground="{DynamicResource MonochromeSecondaryBrush}" Margin="0,0,0,2"/>
                            <ComboBox ItemsSource="{Binding TextSizes, Source={x:Static local:AppPreferences.Current}}"
                                      SelectedItem="{Binding TextSize, Source={x:Static local:AppPreferences.Current}, Mode=TwoWay}"
                                      AutomationProperties.AutomationId="TextSizeCombo"
                                      AutomationProperties.Name="Tamaño de texto"/>

                            <TextBlock Text="Tema" FontWeight="SemiBold"
                                       FontSize="{DynamicResource FsXs}"
                                       Foreground="{DynamicResource MonochromeSecondaryBrush}" Margin="0,10,0,2"/>
                            <ComboBox ItemsSource="{Binding Themes, Source={x:Static local:AppPreferences.Current}}"
                                      SelectedItem="{Binding Theme, Source={x:Static local:AppPreferences.Current}, Mode=TwoWay}"
                                      AutomationProperties.AutomationId="ThemeCombo"
                                      AutomationProperties.Name="Tema monocromático"/>

                            <TextBlock Text="Zoom de interfaz" FontWeight="SemiBold"
                                       FontSize="{DynamicResource FsXs}"
                                       Foreground="{DynamicResource MonochromeSecondaryBrush}" Margin="0,10,0,2"/>
                            <ComboBox ItemsSource="{Binding InterfaceScales, Source={x:Static local:AppPreferences.Current}}"
                                      SelectedItem="{Binding InterfaceScale, Source={x:Static local:AppPreferences.Current}, Mode=TwoWay}"
                                      AutomationProperties.AutomationId="InterfaceScaleCombo"
                                      AutomationProperties.Name="Zoom de interfaz"/>

                            <TextBlock Text="Tipografía" FontWeight="SemiBold"
                                       FontSize="{DynamicResource FsXs}"
                                       Foreground="{DynamicResource MonochromeSecondaryBrush}" Margin="0,10,0,2"/>
                            <ComboBox ItemsSource="{Binding FontChoices, Source={x:Static local:AppPreferences.Current}}"
                                      SelectedItem="{Binding FontChoice, Source={x:Static local:AppPreferences.Current}, Mode=TwoWay}"
                                      AutomationProperties.AutomationId="FontChoiceCombo"
                                      AutomationProperties.Name="Tipografía"/>

                            <TextBlock Text="Nivel de foco" FontWeight="SemiBold"
                                       FontSize="{DynamicResource FsXs}"
                                       Foreground="{DynamicResource MonochromeSecondaryBrush}" Margin="0,10,0,2"/>
                            <ComboBox ItemsSource="{Binding FocusLevels, Source={x:Static local:AppPreferences.Current}}"
                                      SelectedItem="{Binding FocusLevel, Source={x:Static local:AppPreferences.Current}, Mode=TwoWay}"
                                      AutomationProperties.AutomationId="FocusLevelCombo"
                                      AutomationProperties.Name="Nivel de foco"/>

                            <CheckBox Content="Alto contraste" Margin="0,12,0,0"
                                      Foreground="{DynamicResource MonochromeTextBrush}"
                                      IsChecked="{Binding HighContrast, Source={x:Static local:AppPreferences.Current}, Mode=TwoWay}"
                                      AutomationProperties.AutomationId="HighContrastCheck"
                                      AutomationProperties.Name="Alto contraste"/>
                            <CheckBox Content="Reducir movimiento" Margin="0,8,0,0"
                                      Foreground="{DynamicResource MonochromeTextBrush}"
                                      IsChecked="{Binding ReduceMotion, Source={x:Static local:AppPreferences.Current}, Mode=TwoWay}"
                                      AutomationProperties.AutomationId="ReduceMotionCheck"
                                      AutomationProperties.Name="Reducir movimiento"/>

                            <Border Background="{DynamicResource MonochromeSurfaceAltBrush}"
                                    BorderBrush="{DynamicResource MonochromeBorderBrush}"
                                    BorderThickness="1" CornerRadius="6"
                                    Padding="12" Margin="0,14,0,0"
                                    AutomationProperties.Name="Vista previa de accesibilidad">
                                <StackPanel>
                                    <TextBlock Text="VISTA PREVIA"
                                               FontSize="{DynamicResource FsXs}"
                                               Foreground="{DynamicResource MonochromeMutedBrush}"/>
                                    <TextBlock Text="Préstamo guardado"
                                               FontSize="{DynamicResource FsBase}"
                                               Foreground="{DynamicResource MonochromeTextBrush}"
                                               Margin="0,4,0,0"/>
                                    <TextBlock Text="Contraseña ••••••••"
                                               FontSize="{DynamicResource FsXs}"
                                               Foreground="{DynamicResource MonochromeSecondaryBrush}"
                                               Margin="0,2,0,8"/>
                                    <Button Content="Aceptar"
                                            HorizontalAlignment="Left"
                                            MinHeight="30" Padding="12,4"
                                            FontSize="{DynamicResource FsBase}"/>
                                </StackPanel>
                            </Border>

                            <Button Content="Valores por defecto"
                                    Click="ResetAccessibilityClick"
                                    HorizontalAlignment="Stretch"
                                    MinHeight="32" Margin="0,14,0,0"
                                    AutomationProperties.AutomationId="ResetAccessibilityButton"
                                    AutomationProperties.Name="Restablecer accesibilidad"/>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Popup>

        <!-- FLOATING TOAST NOTIFICATIONS (Monocromático, elegante) -->
        <!-- Se ubican en la columna del contenido (no sobre el menú lateral) y
             abajo a la derecha para no quedar tapados por los submenús superiores. -->
        <ItemsControl Grid.Column="1"
                      ItemsSource="{Binding Toasts}"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Bottom"
                      Margin="0,0,24,48"
                      MaxHeight="320"
                      Panel.ZIndex="100"
                      IsHitTestVisible="False"
                      AutomationProperties.Name="Notificaciones">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border x:Name="ToastCard"
                            Background="{DynamicResource MonochromeSurfaceAltBrush}"
                            BorderBrush="{DynamicResource MonochromeBorderStrongBrush}"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="14,12"
                            Margin="0,0,0,10"
                            MinWidth="280" MaxWidth="390"
                            Effect="{StaticResource FloatingShadow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border x:Name="ToastTile"
                                    Width="30" Height="30" CornerRadius="9"
                                    Background="{DynamicResource MonochromePrimaryBrush}"
                                    Margin="0,0,12,0" VerticalAlignment="Top">
                                <Path x:Name="ToastIcon"
                                      Data="M9 16.2 4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4z"
                                      Fill="{DynamicResource MonochromeOnPrimaryBrush}"
                                      Width="15" Height="15" Stretch="Uniform"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="ToastKind" Text="Éxito"
                                               Foreground="{DynamicResource MonochromeSecondaryBrush}"
                                               FontSize="{DynamicResource FsXs}"
                                               FontWeight="SemiBold"/>
                                    <TextBlock x:Name="ToastBrand" Grid.Column="1"
                                               Text="FIADEX" HorizontalAlignment="Right"
                                               Foreground="{DynamicResource MonochromeMutedBrush}"
                                               FontSize="{DynamicResource FsXs}"
                                               FontWeight="SemiBold"/>
                                </Grid>
                                <TextBlock x:Name="ToastText" Text="{Binding Text}"
                                           Foreground="{DynamicResource MonochromeTextBrush}"
                                           FontSize="{DynamicResource FsBase}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsError}" Value="True">
                            <Setter TargetName="ToastCard" Property="Background" Value="{DynamicResource MonochromePrimaryBrush}"/>
                            <Setter TargetName="ToastCard" Property="BorderBrush" Value="{DynamicResource MonochromePrimaryBrush}"/>
                            <Setter TargetName="ToastTile" Property="Background" Value="{DynamicResource MonochromeOnPrimaryBrush}"/>
                            <Setter TargetName="ToastIcon" Property="Fill" Value="{DynamicResource MonochromePrimaryBrush}"/>
                            <Setter TargetName="ToastIcon" Property="Data" Value="M11 5h2v9h-2V5zm0 11h2v2h-2v-2z"/>
                            <Setter TargetName="ToastKind" Property="Text" Value="Error"/>
                            <Setter TargetName="ToastKind" Property="Foreground" Value="{DynamicResource MonochromeOnPrimaryBrush}"/>
                            <Setter TargetName="ToastBrand" Property="Foreground" Value="{DynamicResource MonochromeOnPrimaryBrush}"/>
                            <Setter TargetName="ToastText" Property="Foreground" Value="{DynamicResource MonochromeOnPrimaryBrush}"/>
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Window>




